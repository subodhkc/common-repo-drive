<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>HAIEC — consequence-first entry experience (design reference)</title>
<style>
:root{--bg:#f7f8fb;--paper:#fff;--ink:#13233b;--muted:#576779;--line:#dfe5ec;--navy:#152f51;--blue:#235fa8;--tint:#edf4fd;--green:#247451;--amber:#95621a;--shadow:0 14px 42px rgba(29,54,85,.075)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif}
button,select{font:inherit}button{cursor:pointer}button:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #478add;outline-offset:3px}
button:disabled{opacity:.55;cursor:not-allowed}
a{color:var(--blue)}
.shell{max-width:1200px;margin:0 auto;padding:0 28px 72px}
.header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 0;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px;font-weight:750;letter-spacing:.02em}
.brandmark{width:33px;height:33px;border-radius:10px;background:var(--navy);color:white;display:grid;place-items:center}
.eyebrow{color:var(--blue);text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:750}
.micro{font-size:12px;color:var(--muted)}
.pill{border:1px solid var(--line);border-radius:100px;padding:5px 11px;color:var(--muted);font-size:12px;background:#fff}
.hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(255px,.7fr);gap:26px;padding:49px 0 30px;align-items:center}
h1{font-size:clamp(30px,4.8vw,50px);letter-spacing:-.042em;line-height:1.13;margin:10px 0 15px;font-weight:700}
h2{font-size:23px;line-height:1.25;letter-spacing:-.018em;margin:0 0 9px}
h3{font-size:16px;margin:0 0 8px}
p{margin:0 0 12px}p:last-child{margin-bottom:0}
.lead{font-size:17px;color:var(--muted);max-width:650px}
.hero-note{border:1px solid var(--line);background:var(--paper);padding:20px 21px;border-radius:17px;box-shadow:var(--shadow)}
.note-title{font-weight:700;margin-bottom:8px}.note-row{border-top:1px solid var(--line);padding:10px 0 0;margin-top:10px;font-size:13px;color:var(--muted)}
.section{margin:24px 0 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:15px}
.cards3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.card-choice{text-align:left;background:var(--paper);border:1.5px solid var(--line);border-radius:15px;padding:20px;min-height:145px;color:inherit;box-shadow:0 2px 5px rgba(0,0,0,.012);transition:border-color .13s,box-shadow .13s;display:flex;flex-direction:column;gap:8px}
.card-choice:hover{border-color:#78a5d2;box-shadow:var(--shadow)}
.card-choice.selected{border:2px solid #3571b2;background:#f0f6ff;padding:19.5px}
.icon{font-size:20px;line-height:1}.card-title{font-weight:700;font-size:16px}.card-desc{color:var(--muted);font-size:13px}
.context{background:var(--paper);padding:20px 22px;border:1px solid var(--line);border-radius:15px;margin-top:16px}
.context-head{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
select{border:1px solid #b9c8d9;background:white;border-radius:9px;padding:9px 32px 9px 12px;color:var(--ink);max-width:100%}
.workspace{margin-top:23px;display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.38fr);gap:18px;align-items:start}
.panel{background:var(--paper);border:1px solid var(--line);border-radius:17px;padding:23px;min-width:0}
.stack{display:flex;flex-direction:column;gap:13px}
.subtle{color:var(--muted);font-size:13px}
.chip{border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 11px;font-size:12px}
.chip.selected{background:var(--tint);border-color:#7daadd;color:var(--navy);font-weight:700}
.row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.jobs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:14px 0}
.job{background:white;border:1px solid var(--line);border-radius:11px;padding:11px 12px;min-height:73px;text-align:left;color:var(--ink)}
.job strong{display:block}.job span{font-size:11px;color:var(--muted)}.job.selected{border-color:#337bbd;background:var(--tint)}
.source-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:15px 0}
.source{border:1px solid var(--line);border-radius:12px;padding:13px;min-width:0}
.source strong{display:block;font-size:14px}.source .source-kind{font-size:11px;color:var(--muted);display:block}
.source p{font-size:12px;color:var(--muted);margin:8px 0 12px}
.source button{border-radius:8px;border:1px solid #aac6e4;padding:6px 10px;background:white;font-size:12px;color:var(--blue);font-weight:650}
.source button.selected{background:var(--navy);border-color:var(--navy);color:white}
.source.disabled{background:#fafafa}
.source.disabled button{border-color:var(--line);color:var(--muted)}
.preview-bucket{border-top:1px solid var(--line);padding-top:13px;margin-top:14px}
.bullets{margin:9px 0 0;padding-left:21px;font-size:13px;color:var(--muted)}
.bullets li{margin:6px 0}
.kicker{font-size:11px;letter-spacing:.08em;font-weight:750;text-transform:uppercase;color:var(--blue)}
.detail{background:#f5f8fb;border:1px solid #dfebf4;border-radius:12px;padding:16px;font-size:13px}
.cover-list{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.btn{padding:10px 15px;background:var(--navy);color:white;border:1px solid var(--navy);border-radius:9px;font-weight:650;font-size:13px}
.btn.sub{background:white;color:var(--navy);border-color:#b3c5d6}
.btn.ghost{background:transparent;color:var(--muted);border-color:var(--line)}
small{color:var(--muted)}
details{border-top:1px solid var(--line);padding-top:12px;margin-top:16px}
summary{cursor:pointer;font-weight:650;font-size:13px}
.footer{border-top:1px solid var(--line);padding-top:18px;margin-top:36px;color:var(--muted);font-size:12px}
.modal{border:1px solid var(--line);border-radius:16px;padding:26px;max-width:min(92vw,600px);max-height:80vh;overflow:auto;box-shadow:0 30px 100px rgba(15,32,51,.2)}
.modal::backdrop{background:rgba(16,35,59,.45)}
.modal header{display:flex;align-items:center;justify-content:space-between;gap:12px}
.modal-close{border:1px solid var(--line);border-radius:8px;background:white;padding:5px 10px}
.legend{font-size:12px;line-height:1.6;color:var(--muted)}
hr{border:0;border-top:1px solid var(--line);margin:14px 0}
@media(max-width:850px){.hero,.workspace{grid-template-columns:1fr}.cards3{grid-template-columns:1fr}.hero{padding:30px 0 18px}.jobs{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.shell{padding:0 15px 45px}.source-list,.jobs{grid-template-columns:1fr}.panel{padding:17px}h1{font-size:32px}.section-head{align-items:start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card-choice{transition:none}}
</style>
</head>
<body>
<div class="shell">
<header class="header"><div class="brand"><span class="brandmark">H</span> HAIEC <span class="micro">/ Experience reference</span></div><span class="pill">Illustrative design · No live integrations</span></header>
<section class="hero">
  <div><span class="eyebrow">Human AI Evidence Company · Product entry concept</span>
    <h1>Discover what HAIEC can establish.</h1>
    <p class="lead">Explore the consequential capabilities of your AI systems, choose an objective, or begin with the evidence you already have. You never need every source to start.</p></div>
  <aside class="hero-note"><div class="note-title">Consequence-first, evidence-bound.</div><p class="subtle">HAIEC investigates action paths, authority, observations and target effects. You do not need to know what your AI can cause before the assessment.</p><div class="note-row"><strong>Reference only:</strong> nothing on this page connects a source, uploads a file, runs a detector, changes a policy or issues an Assurance Receipt.</div></aside>
</section>
<section class="section">
 <div class="section-head"><div><span class="eyebrow">One starting point, not a required wizard</span><h2>How would you like to begin?</h2></div><span class="micro">Switch paths anytime. Keep your choices.</span></div>
 <div class="cards3" id="paths" aria-label="Starting points"></div>
 <div class="context" id="context"></div>
</section>
<main class="workspace" id="workspace">
  <section class="panel" id="main-view" aria-live="polite"></section>
  <aside class="panel" id="aside-view" aria-label="Planning preview and evidence requirements"></aside>
</main>
<footer class="footer">Static product-design reference derived from existing HAIEC source contracts. All data, example systems, source status and scenarios are illustrative. The actual app must obtain readiness, output types and evidence claims from its tenant-scoped canonical owners, not this page's example logic.</footer>
</div>
<dialog id="compare" class="modal" aria-labelledby="compare-title"></dialog>
<script>
'use strict';
const JOBS={
  discover:{name:'Discover',tag:'Find systems, agents and tools',min:'Authorized estate access or a qualifying inventory/source export for richer discovery.',out:'Known assets, candidates, tool paths and coverage limitations.',unknown:'Unregistered systems and unobserved runtime actors.'},
  evaluate:{name:'Evaluate',tag:'Assess code, authority and evidence',min:'Selected AI system plus a qualifying source and supported assurance profile.',out:'Scoped HAIEC Assurance Engine assessment with supported findings.',unknown:'Unprovided authority, runtime and target-effect evidence.'},
  authorize:{name:'Authorize',tag:'Govern exact operating decisions',min:'Scoped request or policy and an authorized human reviewer.',out:'Versioned approved policy or digest-bound human decision, when authorized.',unknown:'Whether any approved operation was actually dispatched.'},
  monitor:{name:'Monitor',tag:'Inspect observed behavior',min:'Qualified telemetry or supported historical export with actor/time identity.',out:'Source freshness, bounded observations and eligible detections.',unknown:'Events outside collected coverage and unverified effects.'},
  protect:{name:'Protect',tag:'Inspect and configure safeguards',min:'Control context for inspection; native, authorized target integration for actual enforcement.',out:'Configuration and wiring status; native outcome only where qualified.',unknown:'Any production protection without a verified target binding.'},
  verify:{name:'Verify',tag:'Inspect receipts and evidence basis',min:'An exact eligible evaluation, source report or control result.',out:'Assurance Receipts, Evidence Verification and stated limitations.',unknown:'Unassessed controls, current deployment state and independent effects.'}
};
const SOURCES={
  github:{name:'GitHub App',kind:'Code / authorized repository',adds:'Source-visible action paths and analyzer findings when installed, scanned and qualified.',status:'connection required'},
  ci:{name:'GitHub CI Action',kind:'Code / CI artifact',adds:'Bounded CI findings and qualified scan bundles where a supported release is available.',status:'distribution must be verified',held:true},
  archive:{name:'Source archive',kind:'ZIP / tar.gz',adds:'Source-scoped analysis without a GitHub installation after validation.',status:'upload and scan required'},
  sarif:{name:'SARIF import',kind:'Third-party static findings',adds:'Imported findings with scanner identity and scope; not HAIEC independent detection.',status:'schema and import required'},
  otlp:{name:'OTLP telemetry',kind:'Traces / metrics / logs',adds:'Observed action and source-health questions where instrumentation and a binder exist.',status:'collector and binder required'},
  logs:{name:'Logs or JSON export',kind:'JSONL / CSV / supported raw logs',adds:'Bounded historical event questions after schema mapping and source qualification.',status:'typed mapping required'},
  iam:{name:'IAM evidence',kind:'Live provider or JSON policy export',adds:'Declared permission context; effective per-action grants require extra provider authorization proof.',status:'policy export is not live effective grant'},
  policy:{name:'Operating policy',kind:'Versioned human-approved envelope',adds:'Approved operation/resource limits only after exact-scope human approval.',status:'draft is not authorization'},
  human:{name:'Human evidence upload',kind:'Documents / origin attestation',adds:'Attributed documentary context; does not independently authenticate technical facts.',status:'uploaded is not assessed'},
  delegation:{name:'Delegation records',kind:'Confirmed documents / handoff evidence',adds:'Candidate delegation scopes; independent issuer proof and correlated trace for stronger DAI.',status:'declaration is not verified delegation'},
  sbom:{name:'Dependency evidence',kind:'CycloneDX JSON / manifests',adds:'Declared dependency and component facts at an exact version.',status:'format and scope required'},
  admin:{name:'Provider Admin API usage',kind:'Cost / inventory / attributed usage',adds:'Provider usage and spend context, not proof of agent actions; absent token counts remain unknown.',status:'authorized sync required'},
  runtime:{name:'Runtime security test',kind:'Consented target endpoint',adds:'Empirical test observations in an authorized bounded run.',status:'BETA / authorized target only',held:true},
  industry:{name:'Domain export',kind:'ServiceNow / AWS / telecom / manufacturing',adds:'Typed, domain-specific source evidence where a supported adapter qualifies it.',status:'exact profile required'}
};
const PATTERNS=[
  {label:'Agent tool and API consequences',inputs:['github','archive'],desc:'Potential resource reads, writes and external API calls; no execution claim.'},
  {label:'Delegated authority and DAI',inputs:['delegation','policy','otlp'],desc:'Compare declared authority, action evidence and scope when identities match.'},
  {label:'Permissions and tenant boundaries',inputs:['iam','github'],desc:'Declared grants and code-level tenancy questions, not full effective IAM.'},
  {label:'Data exposure and exfil indicators',inputs:['github','logs','otlp'],desc:'Inspect reachable data paths and qualified observed egress.'},
  {label:'Prompt and retrieval exposure',inputs:['github','archive','runtime'],desc:'Coverage depends on which static or runtime analyzers actually run.'},
  {label:'Deployed operational controls',inputs:['policy','otlp'],desc:'Configuration, monitoring, enforcement wiring and test proof are distinct.'}
];
const SYSTEMS=[
  {id:'support',name:'Support Agent v2',note:'Illustrative system · no real tenant records'},
  {id:'orders',name:'Order Processing Agent',note:'Illustrative system · source readiness unknown'},
  {id:'assistant',name:'Internal Knowledge Assistant',note:'Illustrative system · monitoring readiness unknown'}
];
const STARTERS={
  static:{name:'Static starter',ids:['github','sbom']},
  runtime:{name:'Runtime-first',ids:['otlp','logs']},
  authority:{name:'Authority context',ids:['policy','iam','delegation']}
};
const state={path:'system',system:'support',job:'evaluate',sources:[],showAll:false,openWhy:false};
const el=id=>document.getElementById(id);
const esc=v=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const uniq=a=>Array.from(new Set(a));
function renderPaths(){
 const modes=[
  {id:'system',icon:'◎',title:'Explore an AI system',desc:'Lead with consequential capabilities, authority and what HAIEC can establish.'},
  {id:'goal',icon:'◈',title:'Choose a goal',desc:'Find the minimum input and exact output for six independent customer jobs.'},
  {id:'connect',icon:'⊕',title:'Connect a source',desc:'Start with GitHub, CI, files, telemetry, IAM, policy or evidence you already have.'}
 ];
 el('paths').innerHTML=modes.map(x=>'<button class="card-choice '+(state.path===x.id?'selected':'')+'" data-path="'+x.id+'" aria-pressed="'+(state.path===x.id)+'"><span class="icon">'+x.icon+'</span><span class="card-title">'+x.title+'</span><span class="card-desc">'+x.desc+'</span></button>').join('');
 document.querySelectorAll('[data-path]').forEach(b=>b.addEventListener('click',()=>{state.path=b.dataset.path;render();}));
}
function renderContext(){
 const s=SYSTEMS.find(x=>x.id===state.system);
 el('context').innerHTML='<div class="context-head"><div><strong>AI system context</strong><div class="micro">'+esc(s.note)+'</div></div><label class="micro" for="system-picker">Example system <select id="system-picker">'+SYSTEMS.map(x=>'<option value="'+x.id+'" '+(x.id===s.id?'selected':'')+'>'+esc(x.name)+'</option>').join('')+'</select></label></div>';
 el('system-picker').addEventListener('change',e=>{state.system=e.target.value;render();});
}
function renderJobs(){
 return '<div class="jobs">'+Object.entries(JOBS).map(([id,j])=>'<button class="job '+(state.job===id?'selected':'')+'" data-job="'+id+'" aria-pressed="'+(state.job===id)+'"><strong>'+j.name+'</strong><span>'+j.tag+'</span></button>').join('')+'</div>';
}
function bindJobs(){
 document.querySelectorAll('[data-job]').forEach(b=>b.addEventListener('click',()=>{state.job=b.dataset.job;render();}));
}
function selectedS(){return state.sources.map(k=>SOURCES[k]).filter(Boolean);}
function qualifiedPreview(){
 const chosen=state.sources;
 const relevant=PATTERNS.filter(p=>p.inputs.some(s=>chosen.includes(s)));
 const joins=[];
 if(chosen.includes('policy')&&(chosen.includes('github')||chosen.includes('archive')))joins.push('Code-to-approved-policy comparison may be possible only after exact scope and policy approval qualify.');
 if(chosen.includes('otlp')&&chosen.includes('delegation'))joins.push('Delegation-to-observation comparison may be possible only with trusted identity, scope and trace correlation.');
 if(chosen.includes('otlp')&&chosen.includes('iam'))joins.push('Runtime-to-permission context may be possible; exported IAM JSON never establishes an effective grant alone.');
 if((chosen.includes('github')||chosen.includes('archive'))&&chosen.includes('otlp'))joins.push('Code-to-observation analysis may be possible if the same action/resource identities can be joined.');
 return {relevant,joins};
}
function renderSourceCards(showAll){
 const top=['github','archive','otlp','iam','policy','logs','human','ci'];
 const keys=showAll?Object.keys(SOURCES):top;
 return '<div class="source-list">'+keys.map(id=>{
 const s=SOURCES[id],sel=state.sources.includes(id);
 return '<div class="source '+(s.held?'disabled':'')+'"><strong>'+esc(s.name)+'</strong><span class="source-kind">'+esc(s.kind)+'</span><p>'+esc(s.adds)+'</p><div class="row"><span class="micro">'+esc(s.status)+'</span><button data-source="'+id+'" class="'+(sel?'selected':'')+'" aria-pressed="'+sel+'" title="'+esc('What this could add: '+s.adds)+'">'+(sel?'Selected ✓':'+ Add')+'</button></div></div>';
 }).join('')+'</div>';
}
function renderMain(){
 const j=JOBS[state.job];
 const head='<div class="eyebrow">'+(state.path==='system'?'Explore existing context':state.path==='goal'?'Lightweight objective selection':'Evidence and integration options')+'</div>';
 if(state.path==='system'){
  el('main-view').innerHTML=head+'<h2>Understand consequential capabilities.</h2><p class="subtle">HAIEC discovers source-reachable actions, tests evidence-bound authority and distinguishes observed behavior from verified effects. The examples below are investigation themes, not detected results for the selected system.</p><div class="source-list">'+PATTERNS.map(p=>'<div class="source"><strong>'+esc(p.label)+'</strong><p>'+esc(p.desc)+'</p><button data-investigate="'+esc(p.label)+'" title="View suggested sources for this investigation">Explore requirements →</button></div>').join('')+'</div><div class="row"><button class="btn sub" data-switch="goal">Choose an objective</button><button class="btn" data-switch="connect">Provide evidence</button></div>';
 }else if(state.path==='goal'){
  el('main-view').innerHTML=head+'<h2>What would you like to accomplish?</h2><p class="subtle">These jobs are independent, not mandatory stages. Select a goal to see its evidence contract. You can also begin with a source and refine the goal later.</p>'+renderJobs()+'<div class="detail"><div class="kicker">'+j.name+' · bounded contract</div><p><strong>Minimum to start:</strong> '+esc(j.min)+'</p><p><strong>What you may receive:</strong> '+esc(j.out)+'</p><p><strong>What stays unknown:</strong> '+esc(j.unknown)+'</p></div><div class="row" style="margin-top:16px"><button class="btn" data-switch="connect">Choose available evidence →</button><button class="btn sub" data-switch="system">Explore action paths</button></div>';
 }else{
  const p=qualifiedPreview();
  el('main-view').innerHTML=head+'<h2>Start from evidence you already have.</h2><p class="subtle">Choose candidate source types. Clicking Add does not connect or upload anything. Hover or focus each control for the kind of assessment it could support.</p>'+renderSourceCards(state.showAll)+'<div class="row"><button class="btn sub" id="show-all">'+(state.showAll?'Show recommended sources only':'See all '+Object.keys(SOURCES).length+' source types')+'</button><button class="btn sub" id="compare-open">Compare with a starter</button></div><div class="preview-bucket"><div class="kicker">Possible investigation coverage · not analyzed</div><ul class="bullets">'+(p.relevant.length?p.relevant.map(x=>'<li><strong>'+esc(x.label)+'</strong> — '+esc(x.desc)+'</li>').join(''):'<li>Select a source to preview eligible investigation topics; no evidence has been assessed.</li>')+'</ul></div><div class="preview-bucket"><div class="kicker">Combining selected sources</div><ul class="bullets">'+(p.joins.length?p.joins.map(x=>'<li>'+esc(x)+'</li>').join(''):'<li>Cross-source joins depend on qualified identities, scope, provenance and comparable events; mere selection does not establish them.</li>')+'</ul></div><div class="preview-bucket"><div class="kicker">What is still missing</div><p class="subtle">Installed integration, role/tenant permission, source binder, exact system/producer identity, supported schema, actual detector execution and qualified outcome. Operational enforcement additionally requires native target wiring and appropriate authorization.</p></div>';
 }
 bindMain();
}
function bindMain(){
 document.querySelectorAll('[data-switch]').forEach(b=>b.addEventListener('click',()=>{state.path=b.dataset.switch;render();el('workspace').scrollIntoView({block:'start'});}));
 bindJobs();
 document.querySelectorAll('[data-investigate]').forEach(b=>b.addEventListener('click',()=>{state.path='connect';render();el('workspace').scrollIntoView({block:'start'});}));
 document.querySelectorAll('[data-source]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.source;state.sources=state.sources.includes(id)?state.sources.filter(v=>v!==id):state.sources.concat(id);render();}));
 const show=el('show-all');if(show)show.addEventListener('click',()=>{state.showAll=!state.showAll;render();});
 const cmp=el('compare-open');if(cmp)cmp.addEventListener('click',openCompare);
}
function renderAside(){
 const p=qualifiedPreview();
 const j=JOBS[state.job];
 const suggestions={
  discover:['github','archive','otlp'],
  evaluate:['github','archive','policy','otlp'],
  authorize:['policy','delegation','iam'],
  monitor:['otlp','logs'],
  protect:['policy','otlp'],
  verify:['sarif','human','otlp']
 };
 const missing=(suggestions[state.job]||[]).filter(k=>!state.sources.includes(k)).slice(0,3);
 el('aside-view').innerHTML='<div class="eyebrow">Live planning preview · illustrative only</div><h2 style="font-size:19px;margin-top:7px">What this could establish</h2><p class="subtle">The selected example system has not been queried and there is no live assessment in this HTML. These are source requirement hints.</p><div class="detail"><strong>Selected objective:</strong> '+esc(j.name)+'<br><strong>Candidate source types:</strong> '+state.sources.length+'<br><strong>Possible investigation themes:</strong> '+p.relevant.length+' <span class="micro">(not findings)</span></div><div class="preview-bucket"><div class="kicker">Still unknown</div><p class="subtle">'+esc(j.unknown)+' Current source availability and human approval are also unverified.</p></div><div class="preview-bucket"><div class="kicker">Consider providing</div><div class="cover-list">'+(missing.length?missing.map(id=>'<button class="chip" data-add-suggest="'+id+'" title="'+esc(SOURCES[id].adds)+'">+ '+esc(SOURCES[id].name)+'</button>').join(''):'<span class="subtle">No further example sources suggested for this objective.</span>')+'</div></div><details><summary>Why am I seeing these suggestions?</summary><p class="subtle" style="margin-top:9px">Examples are mapped to the chosen objective and the source types selected in this reference. In HAIEC production, this must come from canonical goal availability, tenant scope, producer activation and evidence qualification—not heuristic file names or this demo configuration.</p></details><hr><button class="btn sub" id="reset-demo">Reset illustration</button>';
 document.querySelectorAll('[data-add-suggest]').forEach(b=>b.addEventListener('click',()=>{if(!state.sources.includes(b.dataset.addSuggest))state.sources.push(b.dataset.addSuggest);state.path='connect';render();}));
 el('reset-demo').addEventListener('click',()=>{state.path='system';state.job='evaluate';state.sources=[];state.system='support';state.showAll=false;render();});
}
function openCompare(){
 const dlg=el('compare'), cur=state.sources;
 dlg.innerHTML='<header><h2 id="compare-title">Compare candidate source sets</h2><button class="modal-close" id="compare-close" aria-label="Close comparison">Close</button></header><p class="subtle">This is a difference in source types, not a prediction of findings or validated assurance coverage.</p>'+Object.values(STARTERS).map(s=>{
 const onlyStarter=s.ids.filter(i=>!cur.includes(i));
 const onlyCurrent=cur.filter(i=>!s.ids.includes(i));
 const shared=cur.filter(i=>s.ids.includes(i));
 return '<div class="detail" style="margin-top:12px"><h3>'+esc(s.name)+'</h3><p><strong>Starter adds:</strong> '+esc(onlyStarter.map(i=>SOURCES[i].name).join(', ')||'Nothing additional')+'</p><p><strong>Your selection adds:</strong> '+esc(onlyCurrent.map(i=>SOURCES[i].name).join(', ')||'Nothing additional')+'</p><p><strong>Shared:</strong> '+esc(shared.map(i=>SOURCES[i].name).join(', ')||'None')+'</p><button class="btn sub" data-apply="'+Object.keys(STARTERS).find(k=>STARTERS[k]===s)+'">Use this illustrative set</button></div>';
 }).join('')+'<p class="micro" style="margin-top:16px">Neither set confirms a source is connected, complete, qualified or executed.</p>';
 dlg.showModal();
 el('compare-close').addEventListener('click',()=>dlg.close());
 dlg.querySelectorAll('[data-apply]').forEach(b=>b.addEventListener('click',()=>{state.sources=STARTERS[b.dataset.apply].ids.slice();state.path='connect';dlg.close();render();}));
}
function render(){renderPaths();renderContext();renderMain();renderAside();}
render();

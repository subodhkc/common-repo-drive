const SYSTEM_NAME = 'Support Agent v2';

/* ─── Helpers ─── */
const $ = (id) => document.getElementById(id);

function ladder(ceiling) {
  let html = `<div class="ladder" aria-hidden="true">`;
  for (let i = 0; i < 7; i++) html += `<span class="dot ${i <= ceiling ? 'filled' : ''}"></span>`;
  return html + '</div>';
}
function ladderInline(ceiling) {
  let html = '<div class="ladder-inline" aria-hidden="true">';
  for (let i = 0; i < 7; i++) html += `<span class="dot ${i <= ceiling ? 'filled' : ''}"></span>`;
  return html + '</div>';
}
function highestCeiling(sources) {
  if (!sources.length) return -1;
  return Math.max(...sources.map(id => SOURCES[id].ceiling));
}

function preview(job, sources) {
  const rules = JOB_RULES[job];
  if (!rules) return { establish:[], oneAway:[], outside:[], whenReady:[] };
  const establish = rules.establishes
    .filter(e => e.requires.some(r => sources.includes(r)))
    .map(e => e.text);
  const oneAway = [];
  const seen = new Set();
  rules.oneAway.forEach(rule => {
    const hasAll = rule.if.every(r => sources.includes(r));
    const missing = !sources.includes(rule.add);
    if (hasAll && missing && !seen.has(rule.unlocks)) {
      seen.add(rule.unlocks);
      oneAway.push({ add: rule.add, unlocks: rule.unlocks });
    }
  });
  return { establish, oneAway, outside: rules.outside.slice(), whenReady: rules.whenReady.slice() };
}


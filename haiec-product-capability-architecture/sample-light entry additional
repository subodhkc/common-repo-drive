<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Start from evidence — HAIEC Navigator</title>
<style>
:root {
  --bg: #fafbfc; --card: #ffffff; --border: #e7e9ee; --border-hover: #d0d4dd;
  --text: #101828; --text-muted: #667085; --text-dim: #98a2b3;
  --primary: #4f46e5; --primary-hover: #4338ca; --primary-light: #f0f1ff; --primary-border: #c7d2fe;
  --success: #067647; --success-bg: #ecfdf3; --success-border: #abefc6;
  --amber: #b54708; --amber-bg: #fffaeb; --amber-border: #fedf89;
  --gray-bg: #f2f4f7;
  --tint-1: #eef4ff; --tint-2: #fef6ee; --tint-3: #ecfdf3; --tint-4: #f4f3ff; --tint-5: #fef3f2; --tint-6: #f0f9ff;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 18px;
  --shadow-sm: 0 1px 2px rgba(16,24,40,0.04);
  --shadow-md: 0 4px 12px rgba(16,24,40,0.07);
  --shadow-lg: 0 20px 48px rgba(16,24,40,0.11);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  font-size: 15px; line-height: 1.55; color: var(--text); background: var(--bg);
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
a { color: inherit; }
button { font-family: inherit; }

/* ─── Page shell ─── */
.page { display: flex; min-height: 100vh; }

/* ─── Rail ─── */
.rail {
  width: 248px; padding: 28px 20px; border-right: 1px solid var(--border);
  background: var(--card); position: sticky; top: 0; height: 100vh;
  flex-shrink: 0; display: flex; flex-direction: column;
}
.rail-brand {
  font-weight: 600; font-size: 14px; color: var(--text);
  display: flex; align-items: center; gap: 10px; padding: 0 4px; margin-bottom: 36px;
}
.rail-brand-mark {
  width: 26px; height: 26px; border-radius: 7px;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: white; display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700; letter-spacing: -0.02em;
}
.rail-steps { list-style: none; display: flex; flex-direction: column; gap: 2px; flex: 1; }
.rail-step {
  display: flex; align-items: center; gap: 12px; padding: 11px 12px;
  border-radius: var(--radius-sm); font-size: 14px; color: var(--text-muted);
  transition: all 0.2s;
}
.rail-step.active { background: var(--primary-light); color: var(--primary); font-weight: 500; }
.rail-step.done { color: var(--success); }
.rail-step-num {
  width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid currentColor;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; flex-shrink: 0; transition: all 0.2s;
}
.rail-step.done .rail-step-num { background: var(--success); color: white; border-color: var(--success); }
.rail-step.active .rail-step-num { background: var(--primary); color: white; border-color: var(--primary); }
.rail-footer { padding: 16px 4px 0; border-top: 1px solid var(--border); }
.rail-footer a { font-size: 12px; color: var(--text-dim); text-decoration: none; cursor: pointer; }
.rail-footer a:hover { color: var(--text); }

/* ─── Canvas ─── */
.canvas { flex: 1; display: flex; flex-direction: column; max-width: 1000px; margin: 0 auto; width: 100%; padding: 0 44px; }
.canvas-header {
  padding: 22px 0 18px; display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--bg); z-index: 10;
}
.crumb { font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 8px; }
.crumb-strong { color: var(--text); font-weight: 500; }
.crumb-sep { color: var(--text-dim); }
.close-btn {
  background: transparent; border: 1px solid var(--border); width: 32px; height: 32px;
  border-radius: var(--radius-sm); cursor: pointer; color: var(--text-muted);
  font-size: 18px; display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; line-height: 1;
}
.close-btn:hover { background: var(--gray-bg); color: var(--text); }
.canvas-body { flex: 1; padding: 40px 0 140px; }
.canvas-footer {
  position: sticky; bottom: 0;
  background: linear-gradient(to top, var(--bg) 60%, rgba(250,251,252,0.92) 85%, transparent);
  padding: 24px 0 28px; display: flex; justify-content: space-between; align-items: center;
  gap: 16px; margin-top: -80px; z-index: 5;
}
.footer-info { font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.footer-info strong { color: var(--text); font-weight: 600; }
.footer-actions { display: flex; gap: 10px; }

/* ─── Type ─── */
h1 {
  font-size: 32px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.2;
  margin-bottom: 12px; color: var(--text);
}
.lead { color: var(--text-muted); font-size: 16px; line-height: 1.55; max-width: 640px; }
h2 { font-size: 20px; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 4px; }

/* ─── Context banner ─── */
.context-banner {
  display: flex; align-items: center; gap: 10px; padding: 12px 16px;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 13px; color: var(--text-muted);
  margin-bottom: 32px;
}
.context-banner strong { color: var(--text); font-weight: 500; }
.context-banner .change { color: var(--primary); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }

/* ─── Buttons ─── */
.btn {
  padding: 10px 18px; border-radius: var(--radius-sm); font-size: 14px; font-weight: 500;
  cursor: pointer; border: 1px solid transparent; transition: all 0.15s;
  display: inline-flex; align-items: center; gap: 6px; letter-spacing: -0.005em;
}
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: white; box-shadow: var(--shadow-sm); }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); box-shadow: var(--shadow-md); }
.btn-ghost { background: transparent; color: var(--text-muted); border-color: var(--border); }
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* ─── Step 1 — Jobs ─── */
.jobs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 32px; }
.job-card {
  background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius-md);
  padding: 20px; cursor: pointer; transition: all 0.2s; text-align: left;
  font: inherit; color: inherit; display: flex; flex-direction: column;
  position: relative;
}
.job-card:hover { border-color: var(--primary); box-shadow: var(--shadow-md); transform: translateY(-2px); }
.job-card.selected { border-color: var(--primary); background: var(--primary-light); box-shadow: var(--shadow-md); }
.job-card.selected::after {
  content: '✓'; position: absolute; top: 14px; right: 14px;
  width: 22px; height: 22px; border-radius: 50%; background: var(--primary); color: white;
  display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;
}
.job-icon-wrap {
  width: 40px; height: 40px; border-radius: 10px; display: flex;
  align-items: center; justify-content: center; font-size: 20px; margin-bottom: 14px;
}
.job-card[data-job="discover"]  .job-icon-wrap { background: var(--tint-1); }
.job-card[data-job="evaluate"]  .job-icon-wrap { background: var(--tint-2); }
.job-card[data-job="authorize"] .job-icon-wrap { background: var(--tint-3); }
.job-card[data-job="monitor"]   .job-icon-wrap { background: var(--tint-4); }
.job-card[data-job="protect"]   .job-icon-wrap { background: var(--tint-5); }
.job-card[data-job="verify"]    .job-icon-wrap { background: var(--tint-6); }
.job-name { font-weight: 600; font-size: 16px; margin-bottom: 2px; letter-spacing: -0.01em; }
.job-tagline { font-size: 13.5px; color: var(--text-muted); margin-bottom: 12px; }
.job-desc { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 14px; flex: 1; }
.job-answers {
  font-size: 12px; color: var(--text-dim); line-height: 1.5;
  padding-top: 12px; border-top: 1px solid var(--border); font-style: italic;
}
.job-answers strong { font-style: normal; color: var(--text-muted); font-weight: 500; }

/* ─── Consequence gallery ─── */
.consequence-section {
  margin-top: 36px; padding-top: 32px; border-top: 1px solid var(--border);
  animation: fadeUp 0.3s ease;
}
.consequence-section h3 { font-size: 14px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; }
.consequence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.consequence {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px 16px; display: flex; gap: 12px; align-items: flex-start;
}
.consequence-icon { font-size: 16px; line-height: 1.4; flex-shrink: 0; }
.consequence-title { font-weight: 500; font-size: 13.5px; margin-bottom: 2px; letter-spacing: -0.005em; }
.consequence-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.45; }

/* ─── Step 2 — Sources ─── */
.section-label { display: flex; align-items: baseline; gap: 10px; margin: 36px 0 14px; }
.section-label .label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); }
.section-label .hint { font-size: 13px; color: var(--text-muted); }
.section-rationale {
  font-size: 13px; color: var(--text-muted); margin: -6px 0 16px; max-width: 640px; line-height: 1.5;
}
.sources-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.source-card {
  background: var(--card); border: 1.5px solid var(--border); border-radius: var(--radius-md);
  padding: 18px; cursor: pointer; transition: all 0.15s;
  position: relative; text-align: left; font: inherit; color: inherit;
  display: flex; flex-direction: column; gap: 10px;
}
.source-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-sm); }
.source-card.selected { border-color: var(--primary); background: var(--primary-light); }
.source-card.selected::after {
  content: '✓'; position: absolute; top: 14px; right: 14px;
  width: 20px; height: 20px; border-radius: 50%; background: var(--primary); color: white;
  display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;
}
.source-head { display: flex; align-items: flex-start; gap: 12px; }
.source-icon { font-size: 20px; line-height: 1.2; }
.source-meta { flex: 1; min-width: 0; }
.source-name { font-weight: 600; font-size: 14.5px; margin-bottom: 1px; }
.source-sub { font-size: 12px; color: var(--text-muted); }
.source-best {
  display: inline-block; font-size: 10.5px; font-weight: 600; padding: 2px 8px;
  border-radius: 4px; background: var(--gray-bg); color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.04em; margin-top: 4px;
}
.source-card.selected .source-best { background: rgba(255,255,255,0.6); }
.source-establishes { font-size: 13px; color: var(--text); line-height: 1.45; }
.source-establishes strong { color: var(--text-muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; display: block; margin-bottom: 2px; }
.source-meta-row { display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px solid var(--border); gap: 8px; }
.source-card.selected .source-meta-row { border-color: rgba(79,70,229,0.2); }
.ladder { display: flex; gap: 3px; }
.dot { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--border-hover); background: transparent; }
.dot.filled { background: var(--primary); border-color: var(--primary); }
.ladder-label { font-size: 10.5px; font-family: ui-monospace, 'SF Mono', Monaco, monospace; color: var(--text-muted); letter-spacing: 0.02em; }
.source-setup { font-size: 11.5px; color: var(--text-dim); white-space: nowrap; }
.source-chip { display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-top: 6px; font-weight: 600; }
.chip-held { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }

/* ─── Packages ─── */
.packages-section { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--border); }
.packages-section h3 { font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 14px; }
.package-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.package-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px 16px; text-align: left; cursor: pointer; transition: all 0.15s;
  font: inherit; color: inherit; display: flex; flex-direction: column; gap: 4px;
}
.package-card:hover { border-color: var(--primary); background: var(--primary-light); }
.package-name { font-weight: 600; font-size: 13.5px; letter-spacing: -0.005em; }
.package-desc { font-size: 12px; color: var(--text-muted); line-height: 1.4; }
.package-meta { font-size: 11px; color: var(--text-dim); margin-top: 4px; }

.show-more-btn {
  margin-top: 20px; background: transparent; border: none; padding: 0;
  color: var(--primary); font-size: 14px; font-weight: 500; cursor: pointer;
  text-decoration: underline; text-underline-offset: 3px;
}

/* ─── Step 3 — Preflight ─── */
.coverage-band {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 14px 18px; background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-sm); margin: 20px 0 24px; font-size: 13px;
}
.coverage-band .cov-left { display: flex; align-items: center; gap: 10px; color: var(--text-muted); }
.coverage-band .cov-right { display: flex; align-items: center; gap: 10px; font-family: ui-monospace, monospace; color: var(--text); font-size: 12px; }
.why-callout {
  padding: 14px 18px; background: var(--primary-light); border: 1px solid var(--primary-border);
  border-radius: var(--radius-sm); margin-bottom: 24px; font-size: 13.5px; color: var(--text);
  line-height: 1.55;
}
.why-callout strong { font-weight: 600; color: var(--primary); }

.sources-summary { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
.source-chip-summary {
  font-size: 13px; padding: 5px 12px 5px 10px; background: var(--card);
  border: 1px solid var(--border); border-radius: 20px;
  display: inline-flex; align-items: center; gap: 6px; color: var(--text);
}

.bucket { border-radius: var(--radius-md); padding: 20px 22px; margin-bottom: 12px; }
.bucket-establish { background: var(--success-bg); border: 1px solid var(--success-border); }
.bucket-away { background: var(--amber-bg); border: 1px solid var(--amber-border); }
.bucket-outside { background: var(--gray-bg); border: 1px solid var(--border); }
.bucket-header {
  display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
  font-weight: 600; font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.05em;
}
.bucket-establish .bucket-header { color: var(--success); }
.bucket-away .bucket-header { color: var(--amber); }
.bucket-outside .bucket-header { color: var(--text-muted); }
.bucket-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.bucket-list li { font-size: 14px; position: relative; line-height: 1.55; }
.bucket-establish .bucket-list li { padding-left: 24px; }
.bucket-establish .bucket-list li::before { content: '✓'; position: absolute; left: 0; color: var(--success); font-weight: 700; font-size: 14px; top: 1px; }
.bucket-away .bucket-list li { padding-left: 24px; }
.bucket-away .bucket-list li::before { content: '○'; position: absolute; left: 3px; color: var(--amber); font-size: 14px; top: 0; }
.bucket-outside .bucket-list li { padding-left: 24px; }
.bucket-outside .bucket-list li::before { content: '·'; position: absolute; left: 8px; color: var(--text-dim); font-weight: 700; font-size: 18px; top: -4px; }
.away-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.away-row .away-text { flex: 1; min-width: 200px; }
.away-row .away-text strong { color: var(--text); font-weight: 500; }
.add-chip {
  font-size: 12.5px; padding: 6px 12px; background: white;
  border: 1px solid var(--amber-border); color: var(--amber);
  border-radius: 6px; cursor: pointer; font-weight: 500;
  white-space: nowrap; transition: all 0.15s; flex-shrink: 0; font-family: inherit;
}
.add-chip:hover { background: var(--amber); color: white; border-color: var(--amber); }

.tech-toggle {
  margin-top: 28px; background: transparent; border: 1px solid var(--border);
  padding: 12px 16px; border-radius: var(--radius-sm); cursor: pointer;
  font-size: 13px; color: var(--text-muted); width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center;
  font-family: inherit; transition: all 0.15s;
}
.tech-toggle:hover { background: var(--gray-bg); }
.tech-detail {
  margin-top: 12px; padding: 18px; background: var(--card);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  font-size: 12px; color: var(--text-muted);
  font-family: ui-monospace, 'SF Mono', Monaco, monospace; line-height: 1.7;
}
.tech-detail .tech-row { display: flex; gap: 12px; padding: 5px 0; }
.tech-detail .tech-key { color: var(--text-dim); min-width: 130px; flex-shrink: 0; }
.tech-detail .tech-val { color: var(--text); }
.tech-detail h4 { color: var(--text); font-size: 13px; font-family: -apple-system, sans-serif; margin-bottom: 8px; font-weight: 600; }

/* ─── Step 4 — Outcome ─── */
.outcome-hero { padding: 8px 0 32px; }
.outcome-icon {
  width: 52px; height: 52px; border-radius: 50%; background: var(--success-bg);
  color: var(--success); display: flex; align-items: center; justify-content: center;
  font-size: 26px; margin-bottom: 18px; border: 2px solid var(--success-border);
}

/* Pipeline */
.pipeline {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 20px 22px; margin-bottom: 24px;
}
.pipeline-header { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); font-weight: 600; margin-bottom: 14px; }
.pipe-stages { display: flex; flex-direction: column; gap: 10px; }
.pipe-stage {
  display: flex; align-items: center; gap: 10px; font-size: 14px;
  color: var(--text-muted); transition: all 0.3s;
}
.pipe-stage.done { color: var(--success); }
.pipe-stage.running { color: var(--text); font-weight: 500; }
.pipe-stage.pending { color: var(--text-dim); }
.pipe-marker {
  width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;
  border: 1.5px solid var(--border-hover); background: white;
}
.pipe-stage.done .pipe-marker { background: var(--success); border-color: var(--success); color: white; }
.pipe-stage.running .pipe-marker { border-color: var(--primary); }
.pipe-stage.running .pipe-marker::after {
  content: ''; width: 8px; height: 8px; border-radius: 50%;
  background: var(--primary); animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.3; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1); } }

.outcome-summary {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 4px 20px; margin-bottom: 24px;
}
.summary-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 0; border-bottom: 1px solid var(--border); font-size: 14px; gap: 16px;
}
.summary-row:last-child { border-bottom: none; }
.summary-label { color: var(--text-muted); flex-shrink: 0; font-size: 13px; }
.summary-value { font-weight: 500; text-align: right; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
.ladder-inline { display: inline-flex; gap: 3px; }
.ladder-inline .dot { width: 7px; height: 7px; }
.ladder-tag { font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-muted); }

.unlocks-section h3 {
  font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-dim); margin-bottom: 12px; margin-top: 28px; font-weight: 600;
}
.unlock-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.unlock-row {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 16px 18px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; font-size: 14px; cursor: pointer; transition: all 0.15s;
  text-align: left; font-family: inherit; color: inherit; width: 100%;
}
.unlock-row:hover { border-color: var(--primary); background: var(--primary-light); }
.unlock-row .unlock-text { display: flex; align-items: center; gap: 12px; }
.unlock-row .arrow { color: var(--primary); font-weight: 600; font-size: 16px; }
.unlock-row .unlock-hint { font-size: 12.5px; color: var(--text-muted); text-align: right; }

.consequence-list {
  list-style: none; display: flex; flex-direction: column; gap: 10px;
  padding: 20px 22px; background: var(--success-bg); border: 1px solid var(--success-border);
  border-radius: var(--radius-md);
}
.consequence-list li { font-size: 14px; line-height: 1.5; padding-left: 24px; position: relative; }
.consequence-list li::before { content: '?'; position: absolute; left: 0; top: 1px; font-weight: 700; color: var(--success); font-size: 15px; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.screen { animation: fadeUp 0.35s ease; }

/* ─── Responsive ─── */
@media (max-width: 900px) {

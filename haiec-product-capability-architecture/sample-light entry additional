    }
  }

  if (state.sources.length === 0) {
    html += `
      <div class="packages-section">
        <h3>Or try a packaged starting point</h3>
        <div class="package-grid">
          ${PACKAGES.map(p => `
            <button class="package-card" data-package="${p.id}">
              <span class="package-name">${p.name}</span>
              <span class="package-desc">${p.desc}</span>
              <span class="package-meta">${p.meta}</span>
            </button>`).join('')}
        </div>
      </div>`;
  }

  html += `</div>`;
  $('canvas-body').innerHTML = html;

  const n = state.sources.length;
  const ceiling = highestCeiling(state.sources);
  const info = n === 0
    ? 'No sources selected yet'
    : `<strong>${n} source${n===1?'':'s'}</strong> selected · reaching <span class="ladder-tag">${LADDER[ceiling]}</span>`;

  $('canvas-footer').innerHTML = `
    <div class="footer-info">${info}</div>
    <div class="footer-actions">
      <button class="btn btn-ghost" id="back-2">← Back</button>
      <button class="btn btn-primary" id="next-2" ${n ? '' : 'disabled'}>Preview preflight →</button>
    </div>
  `;

  document.querySelectorAll('.source-card').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.source;
      const i = state.sources.indexOf(id);
      if (i >= 0) state.sources.splice(i, 1);
      else state.sources.push(id);
      render();
    });
  });
  document.querySelectorAll('[data-package]').forEach(el => {
    el.addEventListener('click', () => {
      const p = PACKAGES.find(x => x.id === el.dataset.package);
      if (p) state.sources = [...p.sources];
      render();
    });
  });
  const toggle = $('toggle-all');
  if (toggle) toggle.addEventListener('click', () => { state.showAll = !state.showAll; render(); });
  $('back-2').addEventListener('click', () => { state.step = 1; render(); });
  $('next-2').addEventListener('click', () => { if (state.sources.length) { state.step = 3; render(); } });
}

/* ─── Step 3 ─── */
function renderStep3() {
  const job = JOBS.find(j => j.id === state.job);
  const p = preview(state.job, state.sources);
  const ceiling = highestCeiling(state.sources);
  const n = state.sources.length;

  let html = `
    <div class="screen">
      <h1>Here\u2019s what this run will establish.</h1>
      <p class="lead">Nothing is assessed yet. This preview shows exactly what HAIEC can tell you from the evidence you picked.</p>

      <div class="coverage-band">
        <div class="cov-left">
          <strong style="color:var(--text);font-weight:600;">${p.establish.length} consequenc${p.establish.length===1?'e':'es'} established</strong>
          <span>·</span>
          <span>${p.oneAway.length} one source away</span>
        </div>
        <div class="cov-right">
          ${ladderInline(ceiling)}
          <span class="ladder-tag">${LADDER[ceiling]}</span>
        </div>
      </div>

      <div class="why-callout">
        <strong>Why this preview exists.</strong> We\u2019re showing you what qualifies, what doesn\u2019t, and what\u2019s one source away \u2014 before you spend a run. Every fact below traces back to the evidence you selected.
      </div>

      <div class="sources-summary">
        ${state.sources.map(id => `
          <span class="source-chip-summary">${SOURCES[id].icon} ${SOURCES[id].name}</span>
        `).join('')}
      </div>

      <div class="bucket bucket-establish">
        <div class="bucket-header">✓ You\u2019ll be able to answer</div>
        <ul class="bucket-list">
  `;

  if (p.establish.length) {
    p.establish.forEach(t => html += `<li>${t}</li>`);
  } else {
    html += `<li style="padding-left:0;color:var(--text-muted);font-style:italic;">These sources alone don\u2019t complete a ${job.name.toLowerCase()} fact. Add one below.</li>`;
  }
  html += `</ul></div>`;

  if (p.oneAway.length) {
    html += `<div class="bucket bucket-away"><div class="bucket-header">○ One source away</div><ul class="bucket-list">`;
    p.oneAway.forEach(row => {
      const s = SOURCES[row.add];
      html += `
        <li>
          <div class="away-row">
            <span class="away-text"><strong>${row.unlocks}</strong> \u2014 add ${s.name.toLowerCase()} to unlock</span>
            <button class="add-chip" data-add="${row.add}">+ ${s.icon} ${s.name}</button>
          </div>
        </li>`;
    });
    html += `</ul></div>`;
  }

  html += `
      <div class="bucket bucket-outside">
        <div class="bucket-header">· Stays outside this run</div>
        <ul class="bucket-list">
          ${p.outside.map(t => `<li>${t}</li>`).join('')}
        </ul>
      </div>

      <button class="tech-toggle" id="tech-toggle">
        <span>Technical detail \u2014 routes, binders, expected schema</span>
        <span>${state.techOpen ? '▲' : '▼'}</span>
      </button>
  `;

  if (state.techOpen) {
    html += `<div class="tech-detail">`;
    state.sources.forEach(id => {
      const s = SOURCES[id];
      html += `
        <div style="margin-bottom:16px;">
          <h4>${s.icon} ${s.name}</h4>
          <div class="tech-row"><span class="tech-key">Ceiling:</span><span class="tech-val">${LADDER[s.ceiling]}</span></div>
          <div class="tech-row"><span class="tech-key">Establishes:</span><span class="tech-val">${s.establishes}</span></div>
          <div class="tech-row"><span class="tech-key">Setup:</span><span class="tech-val">${s.setup}</span></div>
        </div>`;
    });
    html += `</div>`;
  }

  html += `</div>`;
  $('canvas-body').innerHTML = html;

  $('canvas-footer').innerHTML = `
    <div class="footer-info">Typical run: <strong>~2 minutes</strong></div>
    <div class="footer-actions">
      <button class="btn btn-ghost" id="back-3">← Back</button>
      <button class="btn btn-primary" id="start-3">Start assessment →</button>
    </div>
  `;

  document.querySelectorAll('[data-add]').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.add;
      if (!state.sources.includes(id)) state.sources.push(id);
      render();
    });
  });
  $('tech-toggle').addEventListener('click', () => { state.techOpen = !state.techOpen; render(); });
  $('back-3').addEventListener('click', () => { state.step = 2; render(); });
  $('start-3').addEventListener('click', () => {
    state.step = 4; state.pipelineStage = 0; render();
    runPipeline();
  });
}

/* ─── Step 4 ─── */
function runPipeline() {
  const stages = ['Parsing source code','Binding IAM evidence','Running detectors','Evaluating selected planes','Preparing Assurance Case'];
  const maxStage = stages.length - 1;
  if (state._pipeInterval) clearInterval(state._pipeInterval);
  state._pipeInterval = setInterval(() => {
    if (state.step !== 4) { clearInterval(state._pipeInterval); return; }
    state.pipelineStage = Math.min(state.pipelineStage + 1, maxStage);
    renderPipeline();
    if (state.pipelineStage >= maxStage) clearInterval(state._pipeInterval);
  }, 1100);
}

function renderPipeline() {
  const el = document.getElementById('pipe-stages');
  if (!el) return;
  const stages = ['Parsing source code','Binding IAM evidence','Running detectors','Evaluating selected planes','Preparing Assurance Case'];
  el.innerHTML = stages.map((label, i) => {
    let cls = 'pending', marker = '';
    if (i < state.pipelineStage) { cls = 'done'; marker = '✓'; }
    else if (i === state.pipelineStage) { cls = 'running'; }
    return `<div class="pipe-stage ${cls}"><div class="pipe-marker">${marker}</div><span>${label}</span></div>`;
  }).join('');
}

function renderStep4() {
  const job = JOBS.find(j => j.id === state.job);
  const p = preview(state.job, state.sources);
  const ceiling = highestCeiling(state.sources);

  let html = `
    <div class="screen">
      <div class="outcome-hero">
        <div class="outcome-icon">✓</div>
        <h1>Your evidence is in \u2014 HAIEC is assessing now.</h1>
        <p class="lead">You\u2019ll get a complete evidence basis with the exact sources, scope and limitations attached.</p>
      </div>

      <div class="pipeline">
        <div class="pipeline-header">Running</div>
        <div class="pipe-stages" id="pipe-stages"></div>
      </div>

      <div class="outcome-summary">
        <div class="summary-row">
          <span class="summary-label">System</span>
          <span class="summary-value">${SYSTEM_NAME}</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Job</span>
          <span class="summary-value">${job.name}</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Sources (${state.sources.length})</span>
          <span class="summary-value">${state.sources.map(id => SOURCES[id].icon + ' ' + SOURCES[id].name).join(' · ')}</span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Ladder reached</span>
          <span class="summary-value">
            ${ladderInline(ceiling)}
            <span class="ladder-tag">${LADDER[ceiling]}</span>
          </span>
        </div>
      </div>
  `;

  if (p.whenReady.length) {
    html += `
      <div class="unlocks-section" style="margin-top:0;">
        <h3>When results arrive, you\u2019ll be able to answer</h3>
        <ul class="consequence-list">
          ${p.whenReady.map(q => `<li>${q}</li>`).join('')}
        </ul>
      </div>`;
  }

  html += `
    <div class="unlocks-section">
      <h3>What this unlocks</h3>
      <ul class="unlock-list">
        <li>
          <button class="unlock-row" data-action="results">
            <span class="unlock-text"><span class="arrow">→</span> View ${job.name} results</span>
            <span class="unlock-hint">available in ~2 min</span>
          </button>
        </li>
        <li>
          <button class="unlock-row" data-action="case">
            <span class="unlock-text"><span class="arrow">→</span> Open Assurance Case</span>
            <span class="unlock-hint">full evidence-basis view</span>
          </button>
        </li>
      </ul>
    </div>
  `;

  if (p.oneAway.length) {
    html += `
      <div class="unlocks-section">
        <h3>Add a source to strengthen</h3>
        <ul class="unlock-list">
    `;
    p.oneAway.slice(0, 3).forEach(row => {
      const s = SOURCES[row.add];
      html += `
        <li>
          <button class="unlock-row" data-add-from-outcome="${row.add}">
            <span class="unlock-text"><span class="arrow">+</span> ${s.icon} ${s.name}</span>
            <span class="unlock-hint">unlocks ${row.unlocks}</span>
          </button>
        </li>`;
    });
    html += `</ul></div>`;
  }

  html += `</div>`;
  $('canvas-body').innerHTML = html;
  renderPipeline();

  $('canvas-footer').innerHTML = `
    <div class="footer-info">Evidence receipt will attach automatically</div>
    <div class="footer-actions">
      <button class="btn btn-ghost" id="restart-4">↺ Start another</button>
      <button class="btn btn-primary" id="close-4">Back to system</button>
    </div>
  `;

  document.querySelectorAll('[data-action]').forEach(el => {
    el.addEventListener('click', () => {
      el.style.background = 'var(--success-bg)';
      el.style.borderColor = 'var(--success)';
      setTimeout(() => { el.style.background = ''; el.style.borderColor = ''; }, 700);
    });
  });
  document.querySelectorAll('[data-add-from-outcome]').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.addFromOutcome;
      if (!state.sources.includes(id)) state.sources.push(id);
      if (state._pipeInterval) clearInterval(state._pipeInterval);
      state.step = 3; render();
    });
  });
  $('restart-4').addEventListener('click', resetAll);
  $('close-4').addEventListener('click', () => {
    if (state._pipeInterval) clearInterval(state._pipeInterval);
    $('canvas-body').innerHTML = `
      <div class="screen" style="text-align:center;padding:80px 20px;">
        <div style="font-size:52px;margin-bottom:16px;">✓</div>
        <h1>Back to system</h1>
        <p class="lead" style="margin:0 auto;">In the full product this closes the drawer and returns you to the AI System view.</p>
        <button class="btn btn-primary" id="reopen" style="margin-top:28px;">Open the Navigator again</button>
      </div>`;
    $('canvas-footer').innerHTML = '';
    $('reopen').addEventListener('click', resetAll);
  });
}

function resetAll() {
  if (state._pipeInterval) clearInterval(state._pipeInterval);
  state.step = 1; state.job = null; state.sources = [];
  state.showAll = false; state.techOpen = false; state.pipelineStage = 0;
  render();
}

function render() {
  renderRail();
  renderCrumb();
  if (state.step === 1) renderStep1();
  else if (state.step === 2) renderStep2();
  else if (state.step === 3) renderStep3();
  else if (state.step === 4) renderStep4();
}

$('reset-link').addEventListener('click', resetAll);
render();
</script>
</body>
</html>

      <div class="source-meta-row">
        <div>
          ${ladder(s.ceiling)}
          <div class="ladder-label">reaches ${LADDER[s.ceiling]}</div>
        </div>
        <div class="source-setup">${s.setup}</div>
      </div>
      ${chip}
    </button>`;
}


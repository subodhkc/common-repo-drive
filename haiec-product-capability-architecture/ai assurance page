<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Support Agent v2 — AI System Assurance Case · HAIEC</title>
<style>
:root {
  --bg: #fafbfc; --card: #ffffff; --border: #e7e9ee; --border-hover: #d0d4dd;
  --text: #101828; --text-muted: #667085; --text-dim: #98a2b3;
  --primary: #4f46e5; --primary-hover: #4338ca; --primary-light: #f0f1ff; --primary-border: #c7d2fe;
  --success: #067647; --success-bg: #ecfdf3; --success-border: #abefc6;
  --amber: #b54708; --amber-bg: #fffaeb; --amber-border: #fedf89;
  --danger: #b42318; --danger-bg: #fef3f2; --danger-border: #fecdca;
  --gray-bg: #f2f4f7;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px;
  --shadow-sm: 0 1px 2px rgba(16,24,40,0.04);
  --shadow-md: 0 4px 12px rgba(16,24,40,0.07);
  --shadow-lg: 0 24px 56px rgba(16,24,40,0.2);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  font-size: 14.5px; line-height: 1.55; color: var(--text); background: var(--bg);
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
button { font-family: inherit; cursor: pointer; }
code, .mono { font-family: ui-monospace, 'SF Mono', Monaco, monospace; }
a { color: inherit; }

/* ─── Topbar ─── */
.topbar {
  position: sticky; top: 0; z-index: 20;
  background: var(--card); border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 20px;
  padding: 0 28px; height: 60px;
}
.topbar-org {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px;
  font-size: 13px; font-weight: 500; background: var(--bg);
}
.topbar-org-logo {
  width: 20px; height: 20px; border-radius: 5px;
  background: linear-gradient(135deg, #4f46e5, #6366f1); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700;
}
.topbar-system { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
.topbar-system-name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; white-space: nowrap; }
.topbar-env {
  font-size: 10.5px; padding: 2px 8px; border-radius: 4px;
  background: var(--success-bg); color: var(--success);
  border: 1px solid var(--success-border); font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.04em;
}
.topbar-sysid {
  font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-dim);
  padding: 2px 6px; background: var(--gray-bg); border-radius: 4px;
}
.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.basis-control {
  display: flex; align-items: center; gap: 0;
  border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
  background: var(--bg);
}
.basis-btn {
  padding: 6px 12px; font-size: 12px; font-weight: 500; border: none;
  background: transparent; color: var(--text-muted); transition: all 0.15s;
}
.basis-btn.active { background: var(--text); color: white; }
.basis-asof {
  font-family: ui-monospace, monospace; font-size: 11px;
  color: var(--text-muted); padding: 0 10px;
  border-left: 1px solid var(--border);
}
.topbar-search {
  padding: 6px 12px; border: 1px solid var(--border); border-radius: 8px;
  background: var(--bg); font-size: 12.5px; color: var(--text-muted); width: 180px;
}
.topbar-avatar {
  width: 30px; height: 30px; border-radius: 50%;
  background: var(--primary-light); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600;
}

/* ─── Main content ─── */
.main-wrap { max-width: 1400px; margin: 0 auto; padding: 24px 28px 64px; }

/* ─── Hero ─── */
.hero {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md);
  padding: 28px 32px; margin-bottom: 24px;
}
.hero-eyebrow {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 10px;
}
.hero-question {
  font-size: 26px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2;
  margin-bottom: 16px; color: var(--text);
}
.hero-answer {
  font-size: 16px; line-height: 1.65; color: var(--text);
  margin-bottom: 8px; max-width: 900px;
}
.hero-answer strong { font-weight: 600; }
.hero-exposure {
  font-size: 14px; line-height: 1.6; color: var(--text-muted);
  margin-bottom: 20px; max-width: 900px;
}
.hero-exposure .attn-count {
  display: inline-block; font-size: 11px; font-weight: 600;
  padding: 2px 8px; border-radius: 4px; background: var(--amber-bg);
  color: var(--amber); border: 1px solid var(--amber-border);
  margin-right: 6px; vertical-align: middle;
}
.hero-exposure .attn-count.clean {
  background: var(--success-bg); color: var(--success); border-color: var(--success-border);
}
.hero-status {
  display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
  padding-top: 20px; border-top: 1px solid var(--border);
  margin-bottom: 20px;
}
.ladder-wrap { display: flex; align-items: center; gap: 10px; }
.ladder-dots { display: flex; gap: 4px; }
.ladder-dot {
  width: 9px; height: 9px; border-radius: 50%;
  border: 1.5px solid var(--border-hover); background: transparent;
}
.ladder-dot.filled { background: var(--primary); border-color: var(--primary); }
.ladder-label {
  font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-muted);
  letter-spacing: 0.03em;
}
.hero-status-sep { color: var(--text-dim); }
.hero-status-stat {
  display: flex; flex-direction: column; gap: 0;
}
.hero-status-label {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600;
}
.hero-status-value {
  font-size: 13px; color: var(--text); font-weight: 500;
}
.hero-status-value.mono { font-family: ui-monospace, monospace; font-size: 12px; }

.hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.btn {
  padding: 9px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 500;
  border: 1px solid transparent; transition: all 0.15s;
  display: inline-flex; align-items: center; gap: 6px; letter-spacing: -0.005em;
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-ghost { background: transparent; color: var(--text-muted); border-color: var(--border); }
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* ─── Layout grid ─── */
.content-grid {
  display: grid; grid-template-columns: minmax(0, 1fr) 320px;
  gap: 24px; align-items: start;
}
.main-col { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
.sidebar { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 84px; }

/* ─── Section ─── */
.section {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 22px 24px;
}
.section-header {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 12px; margin-bottom: 16px; flex-wrap: wrap;
}
.section-title {
  font-size: 13px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-muted);
}
.section-subtitle { font-size: 12.5px; color: var(--text-muted); margin-top: 2px; }
.section-action {
  font-size: 12.5px; color: var(--primary); text-decoration: underline;
  text-underline-offset: 2px; background: transparent; border: none;
  font-weight: 500; padding: 0;
}

/* ─── Five evidence planes ─── */
.planes {
  display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;
}
.plane {
  background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 12px 14px; cursor: pointer; transition: all 0.15s;
  display: flex; flex-direction: column; gap: 6px; text-align: left;
  font: inherit; color: inherit; min-height: 108px;
}
.plane:hover { border-color: var(--primary); background: var(--primary-light); }
.plane-name {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-muted);
  display: flex; align-items: center; gap: 4px;
}
.plane-state-icon {
  width: 14px; height: 14px; border-radius: 50%; display: flex;
  align-items: center; justify-content: center; font-size: 9px; font-weight: 700;
  flex-shrink: 0;
}
.plane-state-icon.established { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.plane-state-icon.partial { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.plane-state-icon.not-assessed { background: var(--gray-bg); color: var(--text-dim); border: 1px solid var(--border); }
.plane-state-text { font-size: 11px; font-weight: 500; color: var(--text); }
.plane-state-text.partial { color: var(--amber); }
.plane-state-text.not-assessed { color: var(--text-dim); }
.plane-source {
  font-size: 11px; color: var(--text-muted); line-height: 1.35;
  flex: 1; overflow: hidden; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.freshness {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 600; padding: 2px 6px;
  border-radius: 4px; white-space: nowrap; align-self: flex-start;
}
.freshness.fresh { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.freshness.stale { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.freshness.unknown { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }

/* ─── Consequences ─── */
.consequences { display: flex; flex-direction: column; gap: 8px; }
.consequence {
  background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px 16px; cursor: pointer; transition: all 0.15s;
  display: flex; gap: 14px; align-items: flex-start;
  text-align: left; font: inherit; color: inherit; width: 100%;
}
.consequence:hover { border-color: var(--primary); background: var(--primary-light); }
.severity {
  width: 22px; height: 22px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; flex-shrink: 0; margin-top: 1px;
}
.severity.high { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
.severity.medium { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.severity.low { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }
.severity.resolved { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.consequence-body { flex: 1; min-width: 0; }
.consequence-title {
  font-weight: 600; font-size: 14px; margin-bottom: 3px; color: var(--text);
}
.consequence-detail {
  font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 6px;
}
.consequence-basis {
  font-size: 11px; color: var(--text-dim);
  display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
}
.consequence-basis .chip {
  font-size: 10px; padding: 1px 6px; border-radius: 3px;
  background: var(--gray-bg); color: var(--text-muted);
}
.consequence-arrow {
  color: var(--text-dim); font-size: 14px; flex-shrink: 0; margin-top: 2px;
}
.consequence:hover .consequence-arrow { color: var(--primary); }

/* ─── Delta ─── */
.delta-row {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
}
.delta-stat {
  padding: 14px 16px; background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 4px;
}
.delta-stat-label {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600;
}
.delta-stat-value {
  font-size: 22px; font-weight: 600; letter-spacing: -0.02em;
}
.delta-stat-value.added { color: var(--amber); }
.delta-stat-value.resolved { color: var(--success); }
.delta-stat-value.changed { color: var(--text); }
.delta-stat-detail {
  font-size: 11.5px; color: var(--text-muted); margin-top: 2px;
}

/* ─── Controls ─── */
.controls-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.control-card {
  background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px; cursor: pointer; transition: all 0.15s;
  display: flex; flex-direction: column; gap: 6px;
  text-align: left; font: inherit; color: inherit;
}
.control-card:hover { border-color: var(--primary); background: var(--primary-light); }
.control-id {
  font-family: ui-monospace, monospace; font-size: 11px; font-weight: 600;
  color: var(--text-muted); letter-spacing: 0.02em;
}
.control-name {
  font-size: 12.5px; font-weight: 500; color: var(--text); line-height: 1.4;
  flex: 1;
}
.control-state {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 600; padding: 2px 6px;
  border-radius: 4px; white-space: nowrap; align-self: flex-start;
}
.control-state.executed { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.control-state.configured { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.control-state.not-wired { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
.control-state.cataloged { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }

/* ─── Delegated actions table ─── */
.mini-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.mini-table th, .mini-table td {
  padding: 10px 8px; text-align: left; border-bottom: 1px solid var(--border);
}
.mini-table th {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; padding-bottom: 8px;
}
.mini-table tr:last-child td { border-bottom: none; }
.mini-table tr.clickable { cursor: pointer; }
.mini-table tr.clickable:hover td { background: var(--bg); }
.chain-id {
  font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-muted);
}
.chain-route { font-weight: 500; color: var(--text); }
.chain-state { font-family: ui-monospace, monospace; font-size: 10.5px; padding: 2px 8px; border-radius: 4px; font-weight: 600; white-space: nowrap; }
.chain-state.verified { background: var(--success-bg); color: var(--success); }
.chain-state.pending { background: var(--amber-bg); color: var(--amber); }
.chain-state.unverified { background: var(--danger-bg); color: var(--danger); }

/* ─── Evaluations table ─── */
.eval-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.eval-table th, .eval-table td {
  padding: 10px 8px; text-align: left; border-bottom: 1px solid var(--border);
}
.eval-table th {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; padding-bottom: 8px;
}
.eval-table tr:last-child td { border-bottom: none; }
.eval-table tr.clickable { cursor: pointer; }
.eval-table tr.clickable:hover td { background: var(--bg); }
.disposition {
  font-family: ui-monospace, monospace; font-size: 11px; padding: 2px 8px;
  border-radius: 4px; font-weight: 600;
}
.disposition.allow { background: var(--success-bg); color: var(--success); }
.disposition.review { background: var(--amber-bg); color: var(--amber); }
.disposition.block { background: var(--danger-bg); color: var(--danger); }

/* ─── Sidebar cards ─── */
.side-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 18px;
}
.side-card-title {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 12px;
}
.next-action {
  background: linear-gradient(135deg, var(--primary-light), var(--card));
  border: 1px solid var(--primary-border);
}
.next-action-title {
  font-weight: 600; font-size: 14px; margin-bottom: 6px; letter-spacing: -0.01em;
}
.next-action-detail {
  font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px;
}
.next-action-btn {
  width: 100%; padding: 9px 12px; background: var(--primary); color: white;
  border: none; border-radius: 8px; font-size: 13px; font-weight: 500;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: all 0.15s;
}
.next-action-btn:hover { background: var(--primary-hover); }

.jobs-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
}
.job-btn {
  padding: 10px 8px; background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 12px; font-weight: 500;
  color: var(--text); transition: all 0.15s; display: flex;
  flex-direction: column; align-items: center; gap: 4px; text-align: center;
}
.job-btn:hover { border-color: var(--primary); background: var(--primary-light); }
.job-btn-icon { font-size: 16px; }
.job-btn-name { font-size: 11px; color: var(--text-muted); }

.source-health { display: flex; flex-direction: column; gap: 8px; }
.source-health-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; padding: 6px 0; font-size: 12.5px;
  border-bottom: 1px solid var(--border);
}
.source-health-row:last-child { border-bottom: none; }
.source-health-name {
  color: var(--text); font-weight: 500;
  display: flex; align-items: center; gap: 6px;
}
.source-health-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
}
.source-health-dot.fresh { background: var(--success); }
.source-health-dot.stale { background: var(--amber); }
.source-health-dot.unknown { background: var(--text-dim); }

.usage-card {
  background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 12px 14px; cursor: pointer; transition: all 0.15s;
  text-align: left; font: inherit; color: inherit; width: 100%;
}
.usage-card:hover { border-color: var(--primary); background: var(--primary-light); }
.usage-provider {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 4px;
}
.usage-stats {
  display: flex; gap: 12px; align-items: baseline;
  font-size: 12.5px; color: var(--text); margin-bottom: 4px;
}
.usage-stats strong { font-weight: 600; }
.usage-asof {
  font-size: 11px; color: var(--text-muted);
  display: flex; align-items: center; justify-content: space-between;
}
.usage-source {
  font-family: ui-monospace, monospace; font-size: 10px;
  background: var(--gray-bg); padding: 1px 5px; border-radius: 3px;
}

/* ─── Drawer ─── */
.drawer-backdrop {
  position: fixed; inset: 0; background: rgba(16,24,40,0.42);
  opacity: 0; pointer-events: none; transition: opacity 0.28s ease; z-index: 40;
}
.drawer-backdrop.open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(920px, calc(100vw - 40px));
  background: var(--card); box-shadow: var(--shadow-lg);
  transform: translateX(100%); transition: transform 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column; z-index: 50;
}
.drawer.open { transform: translateX(0); }
.drawer-header {
  padding: 18px 28px 14px; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 20px; flex-shrink: 0; background: var(--card);
}
.drawer-header-left { flex: 1; min-width: 0; }
.drawer-crumb {
  font-size: 12px; color: var(--text-muted);
  display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;
}
.drawer-crumb .sep { color: var(--text-dim); }
.drawer-title {
  font-size: 19px; font-weight: 600; letter-spacing: -0.015em;
  margin-bottom: 4px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.drawer-sub { font-size: 13px; color: var(--text-muted); }
.drawer-close {
  width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border);
  background: transparent; display: flex; align-items: center;
  justify-content: center; color: var(--text-muted); font-size: 18px;
  flex-shrink: 0;
}
.drawer-close:hover { background: var(--gray-bg); color: var(--text); }
.drawer-body {
  flex: 1; overflow-y: auto; padding: 24px 28px 28px;
  background: var(--bg);
}
.drawer-body::-webkit-scrollbar { width: 8px; }
.drawer-body::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 4px; }
.drawer-footer {
  padding: 16px 28px; border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  gap: 12px; flex-shrink: 0; background: var(--card);
}
.footer-info { font-size: 12px; color: var(--text-muted); }
.footer-actions { display: flex; gap: 8px; }

/* ─── Drawer content — shared ─── */
.drawer-section {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 18px 20px; margin-bottom: 14px;
}
.drawer-section-title {
  font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 12px;
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.drawer-section-title .badge {
  background: var(--gray-bg); color: var(--text-muted);
  font-size: 10.5px; padding: 1px 7px; border-radius: 10px;
  font-weight: 600; font-family: ui-monospace, monospace;
  text-transform: none; letter-spacing: 0;
}
.drawer-card-list { display: flex; flex-direction: column; gap: 10px; }
.fact-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 24px;
}
.fact-row { font-size: 13px; display: flex; gap: 10px; align-items: baseline; }
.fact-label { color: var(--text-muted); min-width: 120px; flex-shrink: 0; font-size: 12.5px; }
.fact-value { color: var(--text); font-weight: 500; word-break: break-word; }
.fact-value.mono { font-family: ui-monospace, monospace; font-size: 12px; }

.state-block {
  padding: 12px 14px; border-radius: var(--radius-sm);
  display: flex; flex-direction: column; gap: 4px;
}
.state-block.success { background: var(--success-bg); border: 1px solid var(--success-border); }
.state-block.amber { background: var(--amber-bg); border: 1px solid var(--amber-border); }
.state-block.danger { background: var(--danger-bg); border: 1px solid var(--danger-border); }
.state-block.neutral { background: var(--gray-bg); border: 1px solid var(--border); }
.state-block-title {
  font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 8px;
}
.state-block.success .state-block-title { color: var(--success); }
.state-block.amber .state-block-title { color: var(--amber); }
.state-block.danger .state-block-title { color: var(--danger); }
.state-block.neutral .state-block-title { color: var(--text); }
.state-block-detail { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }

/* ─── Navigator drawer specific ─── */
.nav-job-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
}
.nav-job-btn {
  padding: 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  background: var(--bg); text-align: left; transition: all 0.15s;
  display: flex; flex-direction: column; gap: 4px;
}
.nav-job-btn:hover { border-color: var(--primary); background: var(--primary-light); }
.nav-job-btn.selected { border-color: var(--primary); background: var(--primary-light); }
.nav-job-icon { font-size: 18px; }
.nav-job-name { font-weight: 600; font-size: 13px; }
.nav-job-desc { font-size: 11.5px; color: var(--text-muted); line-height: 1.4; }

.nav-source-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.nav-source-btn {
  padding: 12px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  background: var(--bg); text-align: left; transition: all 0.15s;
  display: flex; flex-direction: column; gap: 4px; position: relative;
}
.nav-source-btn:hover { border-color: var(--primary); }
.nav-source-btn.selected { border-color: var(--primary); background: var(--primary-light); }
.nav-source-btn.selected::after {
  content: '✓'; position: absolute; top: 10px; right: 10px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--primary); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700;
}
.nav-source-name { font-weight: 600; font-size: 12.5px; }
.nav-source-sub { font-size: 11px; color: var(--text-muted); }

/* ─── Responsive ─── */
@media (max-width: 1100px) {
  .content-grid { grid-template-columns: 1fr; }
  .sidebar { position: static; display: grid; grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
  .topbar { padding: 0 16px; gap: 12px; }
  .topbar-system-name { font-size: 14px; }
  .topbar-search { width: 100px; }

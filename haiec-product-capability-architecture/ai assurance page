/* ═══════════════════════════════════════════════════════════════
   BINDINGS
   ═══════════════════════════════════════════════════════════════ */
function bindHostEvents() {
  document.querySelectorAll('[data-open-drawer]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const drawerId = el.dataset.openDrawer;
      const chainId = el.dataset.chainId;
      const controlId = el.dataset.controlId;
      const planeId = el.dataset.plane;
      openDrawer(drawerId, { chainId, controlId, planeId });
    });
  });

  document.querySelectorAll('[data-basis-switch]').forEach(el => {
    el.addEventListener('click', () => {
      const targetBasis = el.dataset.basisSwitch;
      if (targetBasis === 'current') {
        setBasis('current');
      } else {
        setBasis('evaluation');
      }
    });
  });

  document.querySelectorAll('[data-job-id]').forEach(el => {
    el.addEventListener('click', () => {
      const job = JOBS.find(j => j.id === el.dataset.jobId);
      if (!job) return;
      if (job.drawer) {
        openDrawer(job.drawer, { controlId: job.controlId });
      } else if (job.targetSection) {
        const target = document.getElementById(job.targetSection);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  document.querySelectorAll('[data-action="open-receipt"]').forEach(el => {
    el.addEventListener('click', () => {
      showToast('Receipt view opening…');
    });
  });
}

function setBasis(basis) {
  state.basis = basis;
  renderAll();
}


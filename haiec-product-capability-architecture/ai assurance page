  .main-wrap { padding: 16px 16px 48px; }
  .hero { padding: 20px; }
  .hero-question { font-size: 22px; }
  .planes { grid-template-columns: repeat(2, 1fr); }
  .drawer { width: 100vw; }
  .drawer-header, .drawer-body, .drawer-footer { padding-left: 18px; padding-right: 18px; }
  .delta-row { grid-template-columns: 1fr; }
  .fact-grid { grid-template-columns: 1fr; }
  .nav-job-grid { grid-template-columns: 1fr 1fr; }
  .nav-source-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {

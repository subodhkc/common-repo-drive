const DRAWER_META = {
  navigator: { crumb: 'Support Agent v2 › Evidence', title: 'Add evidence', subtitle: 'Add more sources to strengthen this assessment', breadcrumb: 'Navigator' },
  delegated: { crumb: 'Support Agent v2 › Agent / Action › Delegated actions', title: 'Delegated action chain', subtitle: '', breadcrumb: 'Delegated chain' },
  controls: { crumb: 'Support Agent v2 › Controls', title: 'Control Operations & Effectiveness', subtitle: '', breadcrumb: 'Controls' },
  coverage: { crumb: 'Support Agent v2 › Detection coverage', title: 'Detection coverage', subtitle: 'What was analyzed in this evaluation', breadcrumb: 'Coverage' },
  usage: { crumb: 'Support Agent v2 › Usage & cost', title: 'Provider usage & cost', subtitle: 'Independent input class — separate from IAM or telemetry', breadcrumb: 'Usage' }
};

function openDrawer(drawerId, opts = {}) {
  state.activeDrawer = drawerId;
  if (opts.chainId) state.activeChainId = opts.chainId;
  if (opts.controlId) state.activeControlId = opts.controlId;
  if (opts.planeId) state.activeCoverageConsequence = null;

  const meta = DRAWER_META[drawerId];
  if (!meta) return;

  document.getElementById('drawer-crumb').innerHTML =
    meta.crumb.split(' › ').map((part, i, arr) =>
      i === arr.length - 1 ? `<span>${part}</span>` : `<span>${part}</span><span class="sep">›</span>`
    ).join('');

  const renderer = DRAWER_RENDERERS[drawerId];
  const result = renderer(opts);

  document.getElementById('drawer-title').textContent = result.title || meta.title;
  document.getElementById('drawer-sub').textContent = result.subtitle || meta.subtitle;
  document.getElementById('drawer-body').innerHTML = result.body;
  document.getElementById('drawer-footer').innerHTML = result.footer || '';

  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawer-backdrop').classList.add('open');

  bindDrawerEvents(drawerId, result);
}

function closeDrawer() {
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawer-backdrop').classList.remove('open');
  state.activeDrawer = null;
}

function bindDrawerEvents(drawerId, result) {
  if (result.actions) {
    Object.entries(result.actions).forEach(([key, fn]) => {
      const el = document.querySelector(`[data-drawer-action="${key}"]`);
      if (el) el.addEventListener('click', fn);
    });
  }
}


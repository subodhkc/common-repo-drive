/* ═══════════════════════ HELPERS ═══════════════════════ */

function evCount(scenario) {
  return scenario.hops.reduce((sum, hop) => sum + hop.evidence.length, 0);
}

/* ═══════════════════════ RENDER ═══════════════════════ */

function renderHeader() {
  const s = SCENARIOS[state.scenario];
  const banner = document.getElementById('verdict-banner');
  banner.className = 'verdict-banner ' + s.tone;
  document.getElementById('verdict-icon').textContent = s.verdictIcon;
  document.getElementById('verdict-text').textContent = s.verdictText;
  document.getElementById('verdict-detail').textContent = s.verdictDetail;
  document.getElementById('chain-id').textContent = s.chainId;
  document.getElementById('drawer-sub').textContent = s.subtitle;
  const ev = evCount(s);
  document.getElementById('footer-info').innerHTML =
    `Trace <strong>${s.traceId}</strong> · ${ev} evidence reference${ev === 1 ? '' : 's'} · ${s.chainIntegrity}`;
}

function renderTabs() {
  const el = document.getElementById('scenario-tabs');
  el.innerHTML = Object.values(SCENARIOS).map(s => `
    <button class="scenario-tab ${s.id === state.scenario ? 'active' : ''}" data-scenario="${s.id}">
      <span class="tab-dot ${s.tone}"></span>${s.label}
    </button>
  `).join('');
  el.querySelectorAll('.scenario-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      state.scenario = btn.dataset.scenario;
      state.expandedEvidence = new Set(['root']);
      state.allExpanded = false;
      render();
      document.getElementById('drawer-body').scrollTop = 0;
    });
  });
}

function renderHero() {
  const s = SCENARIOS[state.scenario];
  const pivot = s.pivotHop ? s.hops.find(h => h.id === s.pivotHop) : null;

  let html = `
    <div class="hero-summary ${s.tone}">
      <div class="hero-top">
        <div class="hero-icon-wrap ${s.tone}">${s.verdictIcon}</div>
        <div class="hero-content">
          <div class="hero-headline">${s.headline}</div>
          <div class="hero-insight">${s.insight}</div>
        </div>
      </div>

      <div class="hero-meta">
        <div class="hero-meta-item">
          <span class="hero-meta-label">Chain integrity</span>
          <span class="hero-meta-value">${s.chainIntegrity}</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Total duration</span>
          <span class="hero-meta-value mono">${s.totalDuration}</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Pivot</span>
          <span class="hero-meta-value">
            ${pivot
              ? `<span class="inline-dot" style="background:var(--${s.tone === 'success' ? 'success' : s.tone});"></span>${pivot.title}`
              : '<span style="color:var(--success);">None — fully qualified</span>'}
          </span>
        </div>
      </div>
  `;

  if (s.nextAction || pivot) {
    html += `<div class="hero-actions">`;
    if (pivot) html += `<button class="btn btn-ghost" data-jump-pivot="${pivot.id}">Jump to pivot →</button>`;
    if (s.nextAction) html += `<span style="font-size:12.5px;color:var(--text-muted);flex:1;align-self:center;">${s.nextAction}</span>`;
    html += `</div>`;
  }

  html += `</div>`;
  return html;
}

function renderControls() {
  return `
    <div class="control-bar">
      <div class="view-toggle">
        <button data-view="chain" class="${state.view === 'chain' ? 'active' : ''}">Chain view</button>
        <button data-view="table" class="${state.view === 'table' ? 'active' : ''}">Table (accessible)</button>
      </div>
      <div class="chain-controls">
        <button class="small-btn" id="expand-all">Expand all evidence</button>
        <button class="small-btn" id="collapse-all">Collapse all</button>
      </div>
    </div>
  `;
}

function renderLegend() {
  return `
    <div class="legend">
      <div class="legend-item"><span class="legend-line qualified"></span>Qualified</div>
      <div class="legend-item"><span class="legend-line candidate"></span>Candidate / widened</div>
      <div class="legend-item"><span class="legend-line pending"></span>Pending readback</div>
    </div>
  `;
}

function renderHop(hop, index) {
  const s = SCENARIOS[state.scenario];
  const isPivot = hop.id === s.pivotHop;
  const expanded = state.expandedEvidence.has(hop.id);
  const isDanger = s.tone === 'danger';

  let html = `
    <div class="hop ${isPivot ? 'pivot' : ''} ${isDanger ? 'danger' : ''}" id="hop-${hop.id}">
      <div class="hop-head">
        <div class="hop-icon-wrap">${hop.icon}</div>
        <div class="hop-meta">
          <div class="hop-title">${hop.title}</div>
          <div class="hop-subtitle">${hop.subtitle}</div>
        </div>
        <div class="hop-badges">
          ${isPivot ? '<span class="pivot-tag">Pivot</span>' : ''}
          <span class="state-badge ${hop.stateTone}">${hop.state}</span>
        </div>
      </div>
      <div class="hop-means">
        <strong>What this means</strong>
        ${hop.means}
      </div>
      <div class="hop-facts">
        ${hop.facts.map(f => `
          <div class="hop-fact">
            <span class="hop-fact-label">${f.label}</span>
            <span class="hop-fact-value ${f.mono ? 'mono' : ''}">${f.value}</span>
          </div>
        `).join('')}
      </div>
  `;

  if (isPivot) {
    html += `
      <div class="hop-why">
        <strong>Why this matters:</strong> This is where the chain's verdict changes. All hops before this are qualified; everything after this is affected by what happened here.
      </div>
    `;
  }

  if (hop.evidence.length) {
    html += `
      <button class="hop-evidence-toggle" data-toggle-evidence="${hop.id}">
        <span>${hop.evidence.length} evidence reference${hop.evidence.length === 1 ? '' : 's'}</span>
        <span>${expanded ? '▲' : '▼'}</span>
      </button>
    `;
    if (expanded) {
      html += `
        <div class="hop-evidence">
          ${hop.evidence.map(ev => `
            <div class="evidence-item">
              <span class="ev-ref">${ev.ref}</span>
              <span class="ev-summary">${ev.summary}</span>
            </div>
          `).join('')}
        </div>
      `;
    }
  } else {
    html += `<div class="hop-empty-evidence">Awaiting readback — evidence will attach once the next scheduled pull completes.</div>`;
  }

  html += `</div>`;
  return html;
}

function renderConnector(link) {
  const iconMap = { qualified: '✓', candidate: '◇', pending: '⋯' };
  return `
    <div class="connector">
      <div class="connector-line ${link.state}"></div>
      <div class="connector-icon">${iconMap[link.state]}</div>
      <div class="connector-label">
        <div class="connector-label-main">${link.label}</div>
        <div class="connector-label-detail">${link.detail}</div>
      </div>
      <div class="connector-duration">${link.duration}</div>
    </div>
  `;
}

function renderChain() {
  const s = SCENARIOS[state.scenario];
  let html = '<div class="chain">';
  s.hops.forEach((hop, i) => {
    html += renderHop(hop, i);
    if (i < s.hops.length - 1) html += renderConnector(s.links[i]);
  });
  html += '</div>';
  return html;
}

function renderDAI() {
  const s = SCENARIOS[state.scenario];
  const matchCount = s.dai.filter(d => d.match).length;
  const widenCount = s.dai.filter(d => !d.match).length;

  return `
    <div class="section">
      <div class="section-title">
        DAI nine-dimension comparison
        <span class="badge-count">${matchCount}/9 match${widenCount > 0 ? ' · ' + widenCount + ' flagged' : ''}</span>
      </div>
      <div class="section-subtitle">Each dimension compares what the parent scope authorized against what the child observed. ${widenCount > 0 ? 'Click a flagged row to jump to the responsible hop.' : ''}</div>
      <div class="dai-table">
        <div class="dai-row dai-header">
          <div>Dimension</div><div>Parent scope</div><div>Child scope</div><div></div>
        </div>
        ${s.dai.map(d => `
          <div class="dai-row ${d.match ? '' : 'mismatch'} ${!d.match && d.hop ? 'clickable' : ''}" ${!d.match && d.hop ? `data-jump-hop="${d.hop}"` : ''}>
            <div class="dai-dim">${d.dimension}</div>
            <div class="dai-value ${d.match ? 'match' : 'mismatch'}">${d.parent}</div>
            <div class="dai-value ${d.match ? 'match' : 'mismatch'}">${d.child}</div>
            <div class="dai-icon ${d.match ? 'match' : 'mismatch'}">${d.match ? '✓' : '⚠'}</div>
          </div>
        `).join('')}
      </div>
      ${widenCount > 0 ? '<div class="dai-hint">Click a flagged dimension to jump to the hop responsible.</div>' : ''}
    </div>
  `;
}


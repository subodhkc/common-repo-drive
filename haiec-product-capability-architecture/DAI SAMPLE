  const s = SCENARIOS[state.scenario];
  return `
    <div class="section">
      <div class="section-title">Chain summary</div>
      <table class="accessible-table">
        <thead>
          <tr><th>Step</th><th>Subject</th><th>State</th><th>What this means</th></tr>
        </thead>
        <tbody>
          ${s.hops.map((hop, i) => `
            <tr>
              <td>${i + 1}${hop.id === s.pivotHop ? ' <strong style="color:var(--amber);">(pivot)</strong>' : ''}</td>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Delegated action chain — HAIEC Assurance Engine</title>
<style>
:root {
  --bg: #fafbfc; --card: #ffffff; --border: #e7e9ee; --border-hover: #d0d4dd;
  --text: #101828; --text-muted: #667085; --text-dim: #98a2b3;
  --primary: #4f46e5; --primary-hover: #4338ca; --primary-light: #f0f1ff; --primary-border: #c7d2fe;
  --success: #067647; --success-bg: #ecfdf3; --success-border: #abefc6;
  --amber: #b54708; --amber-bg: #fffaeb; --amber-border: #fedf89;
  --danger: #b42318; --danger-bg: #fef3f2; --danger-border: #fecdca;
  --gray-bg: #f2f4f7;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px;
  --shadow-sm: 0 1px 2px rgba(16,24,40,0.04);
  --shadow-md: 0 4px 12px rgba(16,24,40,0.07);
  --shadow-lg: 0 24px 56px rgba(16,24,40,0.18);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  font-size: 14.5px; line-height: 1.55; color: var(--text); background: var(--bg);
  -webkit-font-smoothing: antialiased; overflow: hidden;
}
button { font-family: inherit; }
code, .mono { font-family: ui-monospace, 'SF Mono', Monaco, monospace; }

/* Host backdrop */
.host {
  position: fixed; inset: 0;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  display: flex; align-items: center; justify-content: center;
}
.host-card {
  background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md); padding: 32px; max-width: 640px; margin: 0 24px; opacity: 0.5;
}
.host-crumb { font-size: 12px; color: var(--text-dim); margin-bottom: 12px; }
.host-title { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 6px; }
.host-sub { color: var(--text-muted); font-size: 14px; margin-bottom: 20px; }
.host-mini { display: flex; flex-direction: column; gap: 8px; }
.host-mini-row {
  display: flex; align-items: center; gap: 12px; padding: 12px 14px;
  background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
  font-size: 13px;
}
.dot-tag { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* Drawer */
.backdrop {
  position: fixed; inset: 0; background: rgba(16,24,40,0.42);
  opacity: 0; pointer-events: none; transition: opacity 0.28s ease; z-index: 40;
}
.backdrop.open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(1080px, calc(100vw - 40px));
  background: var(--card); box-shadow: var(--shadow-lg);
  transform: translateX(100%); transition: transform 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column; z-index: 50;
}
.drawer.open { transform: translateX(0); }

/* Header */
.drawer-header {
  padding: 18px 28px 14px; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 20px; flex-shrink: 0; background: var(--card);
}
.drawer-header-left { flex: 1; min-width: 0; }
.drawer-crumb { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap; }
.drawer-crumb .sep { color: var(--text-dim); }
.drawer-title { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 4px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.drawer-sub { font-size: 13px; color: var(--text-muted); }
.drawer-toolbar { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.icon-btn {
  width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border);
  background: transparent; display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--text-muted); font-size: 16px; transition: all 0.15s;
}
.icon-btn:hover { background: var(--gray-bg); color: var(--text); }

/* Verdict banner */
.verdict-banner {
  padding: 12px 28px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  font-size: 13.5px; flex-shrink: 0;
}
.verdict-banner.success { background: var(--success-bg); border-bottom-color: var(--success-border); color: var(--success); }
.verdict-banner.amber { background: var(--amber-bg); border-bottom-color: var(--amber-border); color: var(--amber); }
.verdict-banner.danger { background: var(--danger-bg); border-bottom-color: var(--danger-border); color: var(--danger); }
.verdict-banner .verdict-icon { font-size: 16px; font-weight: 700; }
.verdict-banner strong { font-weight: 600; }
.verdict-banner .verdict-detail { color: var(--text-muted); font-size: 12.5px; margin-left: auto; }

/* Scenario tabs */
.scenario-tabs {
  padding: 12px 28px; border-bottom: 1px solid var(--border);
  display: flex; gap: 6px; flex-shrink: 0; overflow-x: auto;
  background: var(--bg); scrollbar-width: none;
}
.scenario-tabs::-webkit-scrollbar { display: none; }
.scenario-tab {
  padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--card); font-size: 13px; font-weight: 500;
  cursor: pointer; color: var(--text-muted); transition: all 0.15s;
  display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
}
.scenario-tab:hover { border-color: var(--border-hover); color: var(--text); }
.scenario-tab.active { background: var(--primary); color: white; border-color: var(--primary); }
.scenario-tab .tab-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.scenario-tab .tab-dot.success { background: var(--success); }
.scenario-tab .tab-dot.amber { background: var(--amber); }
.scenario-tab .tab-dot.danger { background: var(--danger); }
.scenario-tab.active .tab-dot { background: white; }

/* Body */
.drawer-body {
  flex: 1; overflow-y: auto; padding: 20px 28px 28px;
  background: var(--bg); scroll-behavior: smooth;
}
.drawer-body::-webkit-scrollbar { width: 8px; }
.drawer-body::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 4px; }

/* Hero summary */
.hero-summary {
  background: var(--card); border: 1.5px solid var(--border);
  border-radius: var(--radius-md); padding: 20px 22px; margin-bottom: 20px;
}
.hero-summary.success { border-left: 4px solid var(--success); }
.hero-summary.amber { border-left: 4px solid var(--amber); }
.hero-summary.danger { border-left: 4px solid var(--danger); }
.hero-top { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px; }
.hero-icon-wrap {
  width: 44px; height: 44px; border-radius: 11px; display: flex;
  align-items: center; justify-content: center; font-size: 22px;
  flex-shrink: 0; font-weight: 700;
}
.hero-icon-wrap.success { background: var(--success-bg); color: var(--success); }
.hero-icon-wrap.amber { background: var(--amber-bg); color: var(--amber); }
.hero-icon-wrap.danger { background: var(--danger-bg); color: var(--danger); }
.hero-content { flex: 1; min-width: 0; }
.hero-headline {
  font-size: 17px; font-weight: 600; letter-spacing: -0.015em;
  margin-bottom: 4px; line-height: 1.35;
}
.hero-insight {
  font-size: 13.5px; color: var(--text-muted); line-height: 1.55;
}
.hero-insight strong { color: var(--text); font-weight: 500; }
.hero-meta {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
  padding-top: 16px; margin-top: 16px; border-top: 1px solid var(--border);
}
.hero-meta-item { display: flex; flex-direction: column; gap: 2px; }
.hero-meta-label {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600;
}
.hero-meta-value {
  font-size: 13px; color: var(--text); font-weight: 500;
  display: flex; align-items: center; gap: 6px;
}
.hero-meta-value.mono { font-family: ui-monospace, monospace; font-size: 12px; }
.hero-meta-value .inline-dot {
  width: 6px; height: 6px; border-radius: 50%;
}
.hero-actions {
  display: flex; gap: 8px; flex-wrap: wrap;
  padding-top: 16px; margin-top: 16px; border-top: 1px solid var(--border);
}

/* View toggle + controls */
.control-bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; flex-wrap: wrap; margin-bottom: 14px;
}
.view-toggle {
  display: flex; gap: 6px; padding: 6px; background: var(--card);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
}
.view-toggle button {
  padding: 6px 12px; border-radius: 6px; border: none;
  background: transparent; font-size: 12.5px; font-weight: 500;
  cursor: pointer; color: var(--text-muted); transition: all 0.15s;
}
.view-toggle button.active { background: var(--text); color: white; }
.chain-controls { display: flex; gap: 6px; }
.small-btn {
  padding: 6px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border);
  background: var(--card); font-size: 12px; color: var(--text-muted);
  cursor: pointer; transition: all 0.15s; font-weight: 500;
}
.small-btn:hover { background: var(--gray-bg); color: var(--text); }

/* Legend */
.legend {
  display: flex; gap: 16px; flex-wrap: wrap; padding: 10px 14px;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 11.5px;
  color: var(--text-muted); margin-bottom: 16px;
}
.legend-item { display: flex; align-items: center; gap: 6px; }
.legend-line { width: 20px; height: 2px; }
.legend-line.qualified { background: var(--success); }
.legend-line.candidate { background: repeating-linear-gradient(to right, var(--amber) 0, var(--amber) 4px, transparent 4px, transparent 8px); }
.legend-line.pending { background: repeating-linear-gradient(to right, var(--text-dim) 0, var(--text-dim) 2px, transparent 2px, transparent 5px); }

/* Chain */
.chain { position: relative; }
.hop {
  position: relative; background: var(--card); border: 1.5px solid var(--border);
  border-radius: var(--radius-md); padding: 18px 20px;
  transition: all 0.2s; scroll-margin-top: 20px;
}
.hop.pivot {
  border-color: var(--amber);
  box-shadow: 0 0 0 3px rgba(181,71,8,0.08);
}
.hop.pivot.danger { border-color: var(--danger); box-shadow: 0 0 0 3px rgba(180,35,24,0.08); }
.hop.pulse { animation: hopPulse 1.2s ease; }
@keyframes hopPulse {
  0% { box-shadow: 0 0 0 0 rgba(79,70,229,0.4); }
  70% { box-shadow: 0 0 0 12px rgba(79,70,229,0); }
  100% { box-shadow: 0 0 0 0 rgba(79,70,229,0); }
}
.hop-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
.hop-icon-wrap {
  width: 38px; height: 38px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0; border: 1px solid var(--border); background: var(--bg);
}
.hop-meta { flex: 1; min-width: 0; }
.hop-title {
  font-weight: 600; font-size: 15px; margin-bottom: 1px;
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.hop-subtitle { font-size: 12.5px; color: var(--text-muted); }
.hop-badges { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; flex-shrink: 0; }
.state-badge {
  font-family: ui-monospace, monospace; font-size: 10.5px;
  padding: 3px 8px; border-radius: 5px; font-weight: 600;
  letter-spacing: 0.02em; white-space: nowrap;
}
.state-badge.success { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.state-badge.amber { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.state-badge.danger { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
.state-badge.neutral { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }
.pivot-tag {
  font-size: 10px; padding: 3px 8px; border-radius: 5px; font-weight: 700;
  letter-spacing: 0.06em; background: var(--amber); color: white;
  text-transform: uppercase; white-space: nowrap;
}
.hop.pivot.danger .pivot-tag { background: var(--danger); }

/* What this means */
.hop-means {
  font-size: 13px; color: var(--text); line-height: 1.5;
  padding: 10px 12px; background: var(--bg); border-radius: var(--radius-sm);
  margin-bottom: 12px;
}
.hop-means strong { font-weight: 600; color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 3px; }
.hop.pivot .hop-means { background: var(--amber-bg); }
.hop.pivot.danger .hop-means { background: var(--danger-bg); }

.hop-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 24px; }
.hop-fact { font-size: 12.5px; display: flex; gap: 8px; align-items: baseline; }
.hop-fact-label { color: var(--text-muted); min-width: 95px; flex-shrink: 0; font-size: 12px; }
.hop-fact-value { color: var(--text); font-weight: 500; word-break: break-word; }
.hop-fact-value.mono { font-family: ui-monospace, monospace; font-size: 11.5px; }

/* Why this matters (pivot only) */
.hop-why {
  margin-top: 12px; padding: 10px 14px; background: white;
  border: 1px dashed var(--amber-border); border-radius: var(--radius-sm);
  font-size: 12.5px; color: var(--amber); line-height: 1.5;
}
.hop.pivot.danger .hop-why { border-color: var(--danger-border); color: var(--danger); }
.hop-why strong { font-weight: 600; }

/* Evidence */
.hop-evidence-toggle {
  margin-top: 12px; padding: 8px 12px; background: transparent;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  font-size: 12px; color: var(--text-muted); cursor: pointer;
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; transition: all 0.15s;
}
.hop-evidence-toggle:hover { background: var(--bg); color: var(--text); }
.hop-evidence {
  margin-top: 8px; padding: 10px 14px; background: var(--bg);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  display: flex; flex-direction: column; gap: 8px;
}
.evidence-item { font-size: 12px; display: flex; gap: 10px; align-items: flex-start; }
.evidence-item .ev-ref {
  font-family: ui-monospace, monospace; color: var(--primary);
  background: var(--primary-light); padding: 1px 6px; border-radius: 4px;
  font-size: 11px; flex-shrink: 0;
}
.evidence-item .ev-summary { color: var(--text-muted); line-height: 1.5; }
.hop-empty-evidence {
  margin-top: 12px; padding: 12px 14px; background: transparent;
  border: 1px dashed var(--border); border-radius: var(--radius-sm);
  font-size: 12px; color: var(--text-muted); font-style: italic;
}

/* Connector */
.connector {
  position: relative; margin: 0 auto; padding: 6px 0 6px 44px;
  display: flex; align-items: center; gap: 12px;
  font-size: 12px; color: var(--text-muted); min-height: 60px;
}
.connector-line { position: absolute; left: 19px; top: 0; bottom: 0; width: 2px; z-index: 0; }
.connector-line.qualified { background: var(--success); }
.connector-line.candidate { background: repeating-linear-gradient(to bottom, var(--amber) 0, var(--amber) 6px, transparent 6px, transparent 12px); }
.connector-line.pending { background: repeating-linear-gradient(to bottom, var(--text-dim) 0, var(--text-dim) 3px, transparent 3px, transparent 8px); }
.connector-icon {
  position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
  width: 18px; height: 18px; border-radius: 50%; background: var(--card);
  border: 2px solid var(--border-hover); display: flex;
  align-items: center; justify-content: center; font-size: 9px;
  z-index: 1; font-weight: 700;
}
.connector:has(.connector-line.qualified) .connector-icon { border-color: var(--success); color: var(--success); }
.connector:has(.connector-line.candidate) .connector-icon { border-color: var(--amber); color: var(--amber); }
.connector:has(.connector-line.pending) .connector-icon { border-color: var(--text-dim); color: var(--text-dim); }
.connector-label { display: flex; flex-direction: column; gap: 1px; flex: 1; }
.connector-label-main { font-weight: 500; color: var(--text); }
.connector-label-detail { font-size: 11.5px; color: var(--text-muted); }
.connector-duration {
  font-family: ui-monospace, monospace; font-size: 11px;
  color: var(--text-dim); background: var(--card); padding: 2px 8px;
  border-radius: 4px; border: 1px solid var(--border); flex-shrink: 0;
}

/* Sections */
.section { margin-top: 28px; }
.section-title {
  font-size: 12px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-dim); margin-bottom: 12px;
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.section-title .badge-count {
  background: var(--gray-bg); color: var(--text-muted); font-size: 10.5px;
  padding: 1px 7px; border-radius: 10px; font-weight: 600;
  font-family: ui-monospace, monospace;
}
.section-subtitle {
  font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px;
  margin-top: -6px; line-height: 1.5;
}

/* DAI table */
.dai-table {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); overflow: hidden;
}
.dai-row {
  display: grid; grid-template-columns: 130px 1fr 1fr 40px;
  gap: 16px; padding: 12px 18px; border-bottom: 1px solid var(--border);
  align-items: center; font-size: 13px; transition: background 0.15s;
}
.dai-row:last-child { border-bottom: none; }
.dai-row.clickable { cursor: pointer; }
.dai-row.clickable:hover { background: var(--bg); }
.dai-row.mismatch { background: var(--danger-bg); }
.dai-row.mismatch.clickable:hover { background: #fde8e5; }
.dai-header {
  background: var(--bg); font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-dim); font-weight: 600;
  padding: 10px 18px; cursor: default;
}
.dai-dim { font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--text); font-weight: 600; }
.dai-value { color: var(--text-muted); font-size: 12.5px; }
.dai-value.match { color: var(--success); }
.dai-value.mismatch { color: var(--danger); font-weight: 500; }
.dai-icon { text-align: right; font-size: 14px; font-weight: 700; }
.dai-icon.match { color: var(--success); }
.dai-icon.mismatch { color: var(--danger); }
.dai-hint {
  font-size: 11px; color: var(--text-dim); padding: 8px 18px;
  background: var(--bg); border-top: 1px solid var(--border);
  font-style: italic;
}

/* Unverified list */
.unverified-list {
  background: var(--amber-bg); border: 1px solid var(--amber-border);
  border-radius: var(--radius-md); padding: 4px 20px;
}
.unverified-list.danger { background: var(--danger-bg); border-color: var(--danger-border); }
.unverified-list.success { background: var(--success-bg); border-color: var(--success-border); }
.unverified-item { padding: 14px 0; border-bottom: 1px solid rgba(0,0,0,0.06); display: flex; gap: 14px; align-items: flex-start; }
.unverified-list > .unverified-item:last-child { border-bottom: none; }
.unverified-icon {
  width: 24px; height: 24px; border-radius: 50%; background: white;
  border: 1px solid var(--amber-border); display: flex;
  align-items: center; justify-content: center; font-size: 12px;
  color: var(--amber); flex-shrink: 0; font-weight: 700;
}
.unverified-list.danger .unverified-icon { border-color: var(--danger-border); color: var(--danger); }
.unverified-list.success .unverified-icon { border-color: var(--success-border); color: var(--success); }
.unverified-body { flex: 1; }
.unverified-title { font-weight: 500; font-size: 13px; margin-bottom: 2px; color: var(--text); }
.unverified-detail { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

/* Accessible table */
.accessible-table {
  width: 100%; border-collapse: collapse; background: var(--card);
  border: 1px solid var(--border); border-radius: var(--radius-md);
  overflow: hidden; font-size: 12.5px;
}
.accessible-table th, .accessible-table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); }
.accessible-table th { background: var(--bg); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); font-weight: 600; }
.accessible-table tr:last-child td { border-bottom: none; }
.accessible-table td.state-cell { font-family: ui-monospace, monospace; font-size: 11px; }

/* Footer */
.drawer-footer {
  padding: 16px 28px; border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  gap: 12px; flex-shrink: 0; background: var(--card);
}
.footer-info { font-size: 12px; color: var(--text-muted); }
.footer-info strong { color: var(--text); font-weight: 500; }
.footer-actions { display: flex; gap: 8px; }

.btn {
  padding: 8px 16px; border-radius: var(--radius-sm); font-size: 13px;
  font-weight: 500; cursor: pointer; border: 1px solid transparent;
  transition: all 0.15s; display: inline-flex; align-items: center;
  gap: 6px;
}
.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover { background: var(--primary-hover); }
.btn-ghost { background: transparent; color: var(--text-muted); border-color: var(--border); }
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }
.btn-link {
  background: transparent; color: var(--primary); border: none;
  padding: 4px 0; font-size: 12.5px; cursor: pointer; text-decoration: underline;
  text-underline-offset: 2px; font-weight: 500;
}

/* Responsive */
@media (max-width: 900px) {

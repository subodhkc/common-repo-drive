  const s = SCENARIOS[state.scenario];
  if (!s.unverified.length) {
    return `
      <div class="section">
        <div class="section-title">What is unverified</div>
        <div class="unverified-list success">
          <div class="unverified-item" style="border-bottom:none;">
            <div class="unverified-icon">✓</div>
            <div class="unverified-body">

    },
    notEstablishedOverall: [
      'Branch and commit identity — local bundle is not verified against a repository',
      'Full static rule set — 15 rules require remote execution',
      'All IAM, telemetry and runtime facets'
    ]
  },

  /* ─── 4. Runtime-first ─── */
  'runtime-first': {
    id: 'runtime-first',
    tabLabel: 'Runtime-first',
    tone: 'danger',
    title: 'Runtime + telemetry only',
    description: 'No code source connected. Analysis is runtime-observation and empirical test only. Code-visible reachability and supply-chain context are not available.',
    sourceMode: 'Runtime + telemetry',
    facts: [
      { label: 'Source mode', value: 'Runtime only' },
      { label: 'Evaluation', value: 'eval-2f4a-6a8f', mono: true },
      { label: 'As-of', value: '2026-10-15 09:14 UTC' },
      { label: 'Analyzers run', value: '5 of 16' }
    ],
    facets: {
      code: { participation: 'none', summary: 'No code source connected. Source-visible reachability is not available in a runtime-only evaluation.', analyzers: [{ name: 'HAIEC static analyzer', version: '—', status: 'not-run', rules: '—', findings: '—', established: '—', limitations: 'No source code connected' }], established: [], notEstablished: ['Source-visible weaknesses', 'Reachable tool/API paths', 'Secret locations', 'Dependency manifest'], gapAction: { text: 'Connect a source code repository or upload a source bundle.', sourceId: 'source-code' } },
      prompt: { participation: 'partial', summary: 'Observed prompt and RAG events are present in the OTLP telemetry. Static prompt-injection rules did not run — no code source.', analyzers: [{ name: 'Runtime prompt event analyzer', version: 'v1.8', status: 'ran', rules: 'observed prompt events', findings: '2', established: 'Observed prompt content and turn position', limitations: 'Static prompt-injection rules not available without a code source' }], established: ['Observed prompt events with turn position', 'Observed RAG retrieval events'], notEstablished: ['Static prompt-injection rules R1/R4', 'Static RAG boundary analysis'], gapAction: { text: 'Connect a code source to enable static prompt/RAG rules.', sourceId: 'source-code' } },
      tool: { participation: 'partial', summary: 'Observed tool calls and MCP server interactions are present. Static tool-call sink analysis did not run.', analyzers: [{ name: 'Observed tool-call analyzer', version: 'v1.7', status: 'ran', rules: 'observed mcp.* events', findings: '3', established: 'Observed tool calls, servers, schema versions', limitations: 'Static sink analysis not available without code source' }], established: ['Observed tool calls', 'Observed MCP server interactions', 'Tool schema versions from runtime'], notEstablished: ['Static tool-call sink analysis', 'Full-tree undeclared path detection'], gapAction: { text: 'Connect a code source for static tool/MCP analysis.', sourceId: 'source-code' } },
      identity: { participation: 'partial', summary: 'Delegation chain and observed identity events are present in telemetry. No IAM source connected, so effective permission is not established.', analyzers: [{ name: 'Delegation chain analyzer', version: 'v1.4', status: 'ran', rules: 'delegation records', findings: '1', established: 'Observed delegation chains', limitations: null }, { name: 'AWS IAM observer', version: '—', status: 'not-run', rules: '—', findings: '—', established: '—', limitations: 'No IAM source connected' }], established: ['Observed delegation chains', 'Observed agent identities in runtime'], notEstablished: ['Declared IAM grants', 'Effective permission context'], gapAction: { text: 'Connect live IAM or submit an IAM JSON export.', sourceId: 'iam-policy' } },
      supply: { participation: 'none', summary: 'No SBOM or build provenance source connected.', analyzers: [{ name: 'SBOM diff', version: '—', status: 'not-run', rules: '—', findings: '—', established: '—', limitations: 'No SBOM source' }], established: [], notEstablished: ['All supply-chain analysis'], gapAction: { text: 'Upload CycloneDX SBOM.', sourceId: 'sbom' } },
      runtime: { participation: 'full', summary: 'Authorized runtime attack simulation ran against the endpoint. Prompt injection, RAG poisoning and tool forcing were all exercised.', analyzers: [{ name: 'Runtime test runner', version: 'v1.2', status: 'ran', rules: 'prompt injection · RAG poisoning · tool forcing', findings: '2', established: 'Empirical resistance results against authorized endpoint', limitations: null }], established: ['Empirical prompt-injection resistance', 'RAG poisoning resistance', 'Tool-forcing resistance'], notEstablished: [], gapAction: null },
      telemetry: { participation: 'full', summary: 'OTLP collector fresh, log parser running, model gateway events present.', analyzers: [{ name: 'OTLP receiver', version: 'v2.1', status: 'ran', rules: 'gen_ai.*, mcp.*, haiec.*', findings: '12', established: 'Full runtime observation', limitations: null }, { name: 'Log parser', version: 'v1.5', status: 'ran', rules: 'RFC5424 / JSONL', findings: '5', established: 'Access patterns', limitations: null }], established: ['Observed tool calls and handoffs', 'Memory access', 'Retrieval events', 'Model gateway calls', 'Access patterns'], notEstablished: [], gapAction: null },
      governance: { participation: 'partial', summary: 'Operating Envelope present, but no control test executed in this evaluation.', analyzers: [{ name: 'Envelope approval workflow', version: 'v1.3', status: 'ran', rules: 'human approval', findings: '1', established: 'Approved envelope', limitations: null }, { name: 'Control test runner', version: '—', status: 'not-run', rules: '—', findings: '—', established: '—', limitations: 'No control test executed in this evaluation' }], established: ['Operating Envelope approval'], notEstablished: ['Control test execution and receipt'], gapAction: { text: 'Run a control test against the approved envelope.', sourceId: null } }
    },
    notEstablishedOverall: [
      'Source-visible reachability — no code source connected',
      'Static rule coverage — requires code source',
      'Supply-chain context — no SBOM connected',
      'Effective cloud permission — no IAM source'
    ]
  }
};

/* ═══════════════════════════════════════════════════════════════
   STATE
   ═══════════════════════════════════════════════════════════════ */
const state = {
  scenario: 'full-remote',
  openFacets: new Set(['prompt', 'identity'])
};

function currentScenario() { return SCENARIOS[state.scenario]; }

/* ═══════════════════════════════════════════════════════════════
   HELPERS
   ═══════════════════════════════════════════════════════════════ */

const PARTICIPATION_LABELS = {
  full: 'Full',
  partial: 'Partial',
  none: 'Not run',
  na: 'N/A'
};

function scenarioTone(s) {
  const f = s.facets;
  const full = Object.values(f).filter(x => x.participation === 'full').length;
  const none = Object.values(f).filter(x => x.participation === 'none').length;
  if (full >= 6) return 'success';
  if (none >= 4) return 'danger';
  return 'amber';
}

function matrixCount(s) {
  const full = Object.values(s.facets).filter(f => f.participation === 'full').length;
  const partial = Object.values(s.facets).filter(f => f.participation === 'partial').length;
  const none = Object.values(s.facets).filter(f => f.participation === 'none').length;
  return `${full} full · ${partial} partial · ${none} not run`;
}

/* ═══════════════════════════════════════════════════════════════
   RENDER
   ═══════════════════════════════════════════════════════════════ */

function renderHeader() {
  const s = currentScenario();
  document.getElementById('drawer-sub').textContent =
    `${s.sourceMode} · ${s.facts.find(f => f.label === 'Analyzers run')?.value || ''}`;
}

function renderTabs() {
  const el = document.getElementById('scenario-tabs');
  el.innerHTML = Object.values(SCENARIOS).map(s => {
    const tone = scenarioTone(s);
    return `
      <button class="scenario-tab ${s.id === state.scenario ? 'active' : ''}" data-scenario="${s.id}">
        <span class="tab-dot ${tone}"></span>${s.tabLabel}
      </button>`;
  }).join('');
  el.querySelectorAll('.scenario-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      state.scenario = btn.dataset.scenario;
      // Auto-open first non-full facet
      state.openFacets = new Set();
      const firstGap = FACETS.find(f => currentScenario().facets[f.id]?.participation !== 'full');
      if (firstGap) state.openFacets.add(firstGap.id);
      render();
      document.getElementById('drawer-body').scrollTop = 0;
    });
  });
}

function renderInfoCallout() {
  return `
    <div class="info-callout">
      <strong>Analyzer coverage differs by source mode.</strong>
      A static rule existing in another analyzer does not prove this path exercises it.
      The facets below show <em>which analyzers actually ran</em> in this evaluation,
      what each established, and what remains uncovered. Missing source category ≠ clean result.
      <span class="mono">HTTP_200 ≠ QUALIFIED ≠ DETECTOR_EXECUTED</span>
    </div>
  `;
}

function renderScenarioCard() {
  const s = currentScenario();
  const tone = scenarioTone(s);
  return `
    <div class="scenario-card ${tone}">
      <div class="scenario-card-top">
        <div>
          <div class="scenario-card-eyebrow">Source mode</div>
          <div class="scenario-card-title">${s.title}</div>
        </div>
        <span class="scenario-card-badge ${tone}">${matrixCount(s)}</span>
      </div>
      <div class="scenario-card-desc">${s.description}</div>
      <div class="scenario-card-facts">
        ${s.facts.map(f => `
          <div>
            <div class="scenario-fact-label">${f.label}</div>
            <div class="scenario-fact-value ${f.mono ? 'mono' : ''}">${f.value}</div>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

function renderMatrix() {
  const s = currentScenario();
  return `
    <div class="matrix-wrap">
      <div class="matrix-header">
        <span class="matrix-title">Coverage matrix</span>
        <div class="matrix-legend">
          <span class="legend-item"><span class="legend-swatch full"></span>Full</span>
          <span class="legend-item"><span class="legend-swatch partial"></span>Partial</span>
          <span class="legend-item"><span class="legend-swatch none"></span>Not run</span>
          <span class="legend-item"><span class="legend-swatch na"></span>N/A</span>
        </div>
      </div>
      <div class="matrix">
        ${FACETS.map((f, i) => {
          const facet = s.facets[f.id] || { participation: 'none' };
          const p = facet.participation;
          const analyzers = (facet.analyzers || []).filter(a => a.status === 'ran' || a.status === 'partial').length;
          const total = (facet.analyzers || []).length;
          return `
            <button class="matrix-item ${p}" data-jump-facet="${f.id}">
              <span class="matrix-item-icon">${f.icon}</span>
              <span class="matrix-item-label">${f.label}</span>
              <span class="matrix-item-status ${p}">${PARTICIPATION_LABELS[p]}</span>
              <span class="matrix-item-count">${analyzers}/${total} analyzers</span>
            </button>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

function renderAnalyzer(a) {
  const statusClass = a.status === 'ran' ? 'ran' :
                      a.status === 'partial' ? 'partial' :
                      a.status === 'not-run' ? 'not-run' : 'held';
  return `
    <div class="analyzer ${statusClass}">
      <div class="analyzer-head">
        <div class="analyzer-name">
          ${a.name}
          <span class="analyzer-version">${a.version}</span>
        </div>
        <span class="analyzer-status ${statusClass}">${a.status === 'ran' ? 'RAN' : a.status === 'partial' ? 'PARTIAL' : a.status === 'not-run' ? 'NOT RUN' : 'HELD'}</span>
      </div>
      <div class="analyzer-facts">
        <div class="analyzer-fact">
          <span class="analyzer-fact-label">Rules</span>
          <span class="analyzer-fact-value">${a.rules}</span>
        </div>
        <div class="analyzer-fact">
          <span class="analyzer-fact-label">Findings</span>
          <span class="analyzer-fact-value">${a.findings}</span>
        </div>
        <div class="analyzer-fact" style="grid-column: 1 / -1;">
          <span class="analyzer-fact-label">Established</span>
          <span class="analyzer-fact-value">${a.established}</span>
        </div>
      </div>
      ${a.limitations ? `<div class="analyzer-note">${a.limitations}</div>` : ''}
    </div>
  `;
}

function renderFacet(f, i) {
  const s = currentScenario();
  const facet = s.facets[f.id] || { participation: 'none', analyzers: [], established: [], notEstablished: [], summary: '', gapAction: null };
  const p = facet.participation;
  const isOpen = state.openFacets.has(f.id);

  return `
    <div class="facet ${p} ${isOpen ? 'open' : ''}" id="facet-${f.id}">
      <button class="facet-header" data-toggle-facet="${f.id}">
        <span class="facet-num">${String(i+1).padStart(2,'0')}</span>
        <span class="facet-icon">${f.icon}</span>
        <span class="facet-meta">
          <span class="facet-label">${f.label}</span>
          <span class="facet-sub">${f.sub}</span>
        </span>
        <span class="facet-state ${p}">${PARTICIPATION_LABELS[p]}</span>
        <span class="facet-chevron">▼</span>
      </button>
      <div class="facet-body">
        <div class="facet-summary">${facet.summary}</div>

        <div class="analyzers-title">Analyzers & participation</div>
        <div class="analyzer-list">
          ${(facet.analyzers || []).map(renderAnalyzer).join('')}
        </div>

        <div class="est-grid">
          <div class="est-block established">
            <div class="est-block-title">What this established (${facet.established.length})</div>
            <ul class="est-list">
              ${facet.established.length
                ? facet.established.map(x => `<li>${x}</li>`).join('')
                : '<li style="color:var(--text-muted);font-style:italic;padding-left:0;">Nothing in this run</li>'}
            </ul>
          </div>
          <div class="est-block not-established">
            <div class="est-block-title">What this did not establish (${facet.notEstablished.length})</div>
            <ul class="est-list">
              ${facet.notEstablished.length
                ? facet.notEstablished.map(x => `<li>${x}</li>`).join('')
                : '<li style="color:var(--success);font-style:italic;padding-left:0;">No coverage gap in this facet</li>'}
            </ul>
          </div>
        </div>

        ${facet.gapAction ? `
          <div class="facet-gap-action">
            <strong>Close this gap:</strong>
            <span>${facet.gapAction.text}</span>
            ${facet.gapAction.sourceId ? `<button class="btn-link" data-add-source="${facet.gapAction.sourceId}">+ Add source →</button>` : ''}
          </div>
        ` : ''}
      </div>
    </div>
  `;
}

function renderFacets() {
  const s = currentScenario();
  return `
    <div class="facet-list">
      ${FACETS.map((f, i) => renderFacet(f, i)).join('')}
    </div>
  `;
}

function renderOverallNotEstablished() {
  const s = currentScenario();
  return `
    <div class="not-establish-callout">
      <div class="not-establish-title">What this evaluation does not establish overall</div>
      <div class="not-establish-items">
        ${s.notEstablishedOverall.map(item => `
          <div class="not-establish-item">
            <span class="icon">·</span>
            <span>${item}</span>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

function renderFooter() {
  const s = currentScenario();
  const fullCount = Object.values(s.facets).filter(f => f.participation === 'full').length;
  const partialCount = Object.values(s.facets).filter(f => f.participation === 'partial').length;
  const noneCount = Object.values(s.facets).filter(f => f.participation === 'none').length;
  return `
    <div class="footer-info">
      <strong>${s.sourceMode}</strong> · ${fullCount} full · ${partialCount} partial · ${noneCount} not run
    </div>
    <div class="footer-actions">
      <button class="btn btn-ghost" id="footer-add-source">+ Add source</button>
      <button class="btn btn-ghost" id="footer-export">Export coverage receipt</button>
      <button class="btn btn-primary" id="footer-done">Done</button>
    </div>
  `;
}

function render() {
  renderHeader();
  renderTabs();
  const body = document.getElementById('drawer-body');
  body.innerHTML =
    renderInfoCallout() +
    renderScenarioCard() +
    renderMatrix() +
    renderFacets() +
    renderOverallNotEstablished();
  document.getElementById('drawer-footer').innerHTML = renderFooter();

  body.querySelectorAll('[data-toggle-facet]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.toggleFacet;
      if (state.openFacets.has(id)) state.openFacets.delete(id);
      else state.openFacets.add(id);
      const el = document.getElementById('facet-' + id);
      if (el) el.classList.toggle('open', state.openFacets.has(id));
    });
  });

  body.querySelectorAll('[data-jump-facet]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.jumpFacet;
      state.openFacets.add(id);
      const el = document.getElementById('facet-' + id);
      if (el) {
        el.classList.add('open');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.remove('pulse');
        void el.offsetWidth;
        el.classList.add('pulse');
        setTimeout(() => el.classList.remove('pulse'), 1300);
      }
    });
  });

  body.querySelectorAll('[data-add-source]').forEach(btn => {
    btn.addEventListener('click', () => {
      const sourceId = btn.dataset.addSource;
      showToast(`Would open Navigator drawer · pre-select ${sourceId}`);
    });
  });

  document.getElementById('footer-add-source').addEventListener('click', () => {
    showToast('Opening Navigator drawer');
  });
  document.getElementById('footer-export').addEventListener('click', () => {
    showToast('Coverage receipt exported · includes per-analyzer participation');
  });
  document.getElementById('footer-done').addEventListener('click', closeDrawer);
}

/* ═══════════════════════════════════════════════════════════════
   CHROME
   ═══════════════════════════════════════════════════════════════ */

function openDrawer() {
  document.getElementById('drawer').classList.add('open');
  document.getElementById('drawer-backdrop').classList.add('open');
}
function closeDrawer() {
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawer-backdrop').classList.remove('open');
}

document.getElementById('close-btn').addEventListener('click', closeDrawer);
document.getElementById('drawer-backdrop').addEventListener('click', closeDrawer);
document.getElementById('host').addEventListener('click', openDrawer);

document.getElementById('copy-btn').addEventListener('click', () => {
  const btn = document.getElementById('copy-btn');
  btn.textContent = '✓';
  setTimeout(() => { btn.textContent = '⧉'; }, 1200);
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeDrawer();
});

function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.style.opacity = '1';
  clearTimeout(toast._t);
  toast._t = setTimeout(() => { toast.style.opacity = '0'; }, 2400);
}

/* Init */
render();
</script>
</body>
</html>

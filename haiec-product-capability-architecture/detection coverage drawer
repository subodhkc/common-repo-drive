<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Detection coverage — HAIEC Assurance Engine</title>
<style>
:root {
  --bg: #fafbfc; --card: #ffffff; --border: #e7e9ee; --border-hover: #d0d4dd;
  --text: #101828; --text-muted: #667085; --text-dim: #98a2b3;
  --primary: #4f46e5; --primary-hover: #4338ca; --primary-light: #f0f1ff; --primary-border: #c7d2fe;
  --success: #067647; --success-bg: #ecfdf3; --success-border: #abefc6;
  --amber: #b54708; --amber-bg: #fffaeb; --amber-border: #fedf89;
  --danger: #b42318; --danger-bg: #fef3f2; --danger-border: #fecdca;
  --gray-bg: #f2f4f7;
  --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px;
  --shadow-sm: 0 1px 2px rgba(16,24,40,0.04);
  --shadow-md: 0 4px 12px rgba(16,24,40,0.07);
  --shadow-lg: 0 24px 56px rgba(16,24,40,0.2);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  font-size: 14.5px; line-height: 1.55; color: var(--text); background: var(--bg);
  -webkit-font-smoothing: antialiased; overflow: hidden;
}
button { font-family: inherit; cursor: pointer; }
code, .mono { font-family: ui-monospace, 'SF Mono', Monaco, monospace; }

/* Host backdrop */
.host {
  position: fixed; inset: 0;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  display: flex; align-items: center; justify-content: center;
}
.host-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); box-shadow: var(--shadow-md);
  padding: 32px; max-width: 640px; margin: 0 24px; opacity: 0.5;
}
.host-crumb { font-size: 12px; color: var(--text-dim); margin-bottom: 12px; }
.host-title { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 6px; }
.host-sub { color: var(--text-muted); font-size: 14px; margin-bottom: 20px; }
.host-mini { display: flex; flex-direction: column; gap: 8px; }
.host-mini-row {
  display: flex; align-items: center; gap: 12px; padding: 12px 14px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-size: 13px;
}
.dot-tag { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* Drawer */
.drawer-backdrop {
  position: fixed; inset: 0; background: rgba(16,24,40,0.42);
  opacity: 0; pointer-events: none; transition: opacity 0.28s ease; z-index: 40;
}
.drawer-backdrop.open { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(1080px, calc(100vw - 40px));
  background: var(--card); box-shadow: var(--shadow-lg);
  transform: translateX(100%); transition: transform 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column; z-index: 50;
}
.drawer.open { transform: translateX(0); }

.drawer-header {
  padding: 18px 28px 14px; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 20px; flex-shrink: 0; background: var(--card);
}
.drawer-header-left { flex: 1; min-width: 0; }
.drawer-crumb {
  font-size: 12px; color: var(--text-muted);
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 6px; flex-wrap: wrap;
}
.drawer-crumb .sep { color: var(--text-dim); }
.drawer-title {
  font-size: 19px; font-weight: 600; letter-spacing: -0.015em;
  margin-bottom: 4px; display: flex; align-items: center;
  gap: 10px; flex-wrap: wrap;
}
.drawer-sub { font-size: 13px; color: var(--text-muted); }
.drawer-toolbar { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.icon-btn {
  width: 32px; height: 32px; border-radius: var(--radius-sm);
  border: 1px solid var(--border); background: transparent;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--text-muted); font-size: 16px;
  transition: all 0.15s;
}
.icon-btn:hover { background: var(--gray-bg); color: var(--text); }

/* Scenario tabs */
.scenario-tabs {
  padding: 12px 28px; border-bottom: 1px solid var(--border);
  display: flex; gap: 6px; flex-shrink: 0; overflow-x: auto;
  background: var(--bg); scrollbar-width: none;
}
.scenario-tabs::-webkit-scrollbar { display: none; }
.scenario-tab {
  padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--card); font-size: 13px; font-weight: 500;
  cursor: pointer; color: var(--text-muted); transition: all 0.15s;
  display: inline-flex; align-items: center; gap: 8px;
  white-space: nowrap; font-family: inherit;
}
.scenario-tab:hover { border-color: var(--border-hover); color: var(--text); }
.scenario-tab.active { background: var(--primary); color: white; border-color: var(--primary); }
.scenario-tab .tab-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.scenario-tab .tab-dot.success { background: var(--success); }
.scenario-tab .tab-dot.amber { background: var(--amber); }
.scenario-tab .tab-dot.danger { background: var(--danger); }
.scenario-tab .tab-dot.neutral { background: var(--text-dim); }
.scenario-tab.active .tab-dot { background: white; }

/* Drawer body */
.drawer-body {
  flex: 1; overflow-y: auto; padding: 20px 28px 28px;
  background: var(--bg); scroll-behavior: smooth;
}
.drawer-body::-webkit-scrollbar { width: 8px; }
.drawer-body::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 4px; }

/* Info callout */
.info-callout {
  background: var(--primary-light); border: 1px solid var(--primary-border);
  border-radius: var(--radius-md); padding: 14px 18px;
  font-size: 13px; color: var(--text); line-height: 1.55; margin-bottom: 18px;
}
.info-callout strong { font-weight: 600; color: var(--primary); }
.info-callout .mono {
  font-family: ui-monospace, monospace; font-size: 11px;
  background: rgba(255,255,255,0.5); padding: 1px 5px; border-radius: 3px;
}

/* Scenario explanation card */
.scenario-card {
  background: var(--card); border: 1.5px solid var(--border);
  border-radius: var(--radius-md); padding: 18px 22px; margin-bottom: 18px;
  border-left: 4px solid var(--border);
}
.scenario-card.success { border-left-color: var(--success); }
.scenario-card.amber { border-left-color: var(--amber); }
.scenario-card.danger { border-left-color: var(--danger); }
.scenario-card.neutral { border-left-color: var(--text-dim); }
.scenario-card-top {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 16px; margin-bottom: 12px; flex-wrap: wrap;
}
.scenario-card-eyebrow {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 3px;
}
.scenario-card-title {
  font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
  line-height: 1.35; color: var(--text);
}
.scenario-card-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; font-weight: 600; padding: 5px 12px;
  border-radius: 6px; white-space: nowrap;
}
.scenario-card-badge.success { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.scenario-card-badge.amber { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.scenario-card-badge.danger { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
.scenario-card-badge.neutral { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }
.scenario-card-desc {
  font-size: 13px; color: var(--text-muted); line-height: 1.55; margin-bottom: 12px;
}
.scenario-card-facts {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 12px 20px; padding-top: 14px; border-top: 1px solid var(--border);
}
.scenario-fact-label {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 2px;
}
.scenario-fact-value {
  font-size: 13px; color: var(--text); font-weight: 500;
}
.scenario-fact-value.mono { font-family: ui-monospace, monospace; font-size: 12px; }

/* Coverage matrix — 8 cards */
.matrix-wrap {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 18px 20px; margin-bottom: 18px;
}
.matrix-header {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 12px; margin-bottom: 14px; flex-wrap: wrap;
}
.matrix-title {
  font-size: 12px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-muted);
}
.matrix-legend {
  display: flex; gap: 12px; font-size: 11px; color: var(--text-muted);
  flex-wrap: wrap;
}
.legend-item { display: inline-flex; align-items: center; gap: 5px; }
.legend-swatch {
  width: 9px; height: 9px; border-radius: 2px;
}
.legend-swatch.full { background: var(--success); }
.legend-swatch.partial { background: var(--amber); }
.legend-swatch.none { background: var(--danger); }
.legend-swatch.na { background: var(--text-dim); }

.matrix {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
}
.matrix-item {
  background: var(--bg); border: 1.5px solid var(--border);
  border-radius: var(--radius-sm); padding: 12px 14px;
  text-align: left; transition: all 0.15s;
  display: flex; flex-direction: column; gap: 4px;
  cursor: pointer; position: relative; min-height: 104px;
  border-left: 3px solid var(--border);
}
.matrix-item:hover { border-color: var(--border-hover); }
.matrix-item.full { border-left-color: var(--success); }
.matrix-item.partial { border-left-color: var(--amber); }
.matrix-item.none { border-left-color: var(--danger); }
.matrix-item.na { border-left-color: var(--text-dim); }
.matrix-item.pulse { animation: matrixPulse 1.2s ease; }
@keyframes matrixPulse {
  0% { box-shadow: 0 0 0 0 rgba(79,70,229,0.4); }
  70% { box-shadow: 0 0 0 10px rgba(79,70,229,0); }
  100% { box-shadow: 0 0 0 0 rgba(79,70,229,0); }
}
.matrix-item-icon { font-size: 16px; margin-top: 2px; }
.matrix-item-label {
  font-size: 12px; font-weight: 600; color: var(--text);
  line-height: 1.3;
}
.matrix-item-status {
  font-size: 10.5px; font-weight: 600; padding: 2px 7px;
  border-radius: 3px; display: inline-block; margin-top: 3px;
  align-self: flex-start;
}
.matrix-item-status.full { background: var(--success-bg); color: var(--success); }
.matrix-item-status.partial { background: var(--amber-bg); color: var(--amber); }
.matrix-item-status.none { background: var(--danger-bg); color: var(--danger); }
.matrix-item-status.na { background: var(--gray-bg); color: var(--text-muted); }
.matrix-item-count {
  font-size: 10.5px; color: var(--text-dim);
  font-family: ui-monospace, monospace; margin-top: auto;
}

/* Facet accordion */
.facet-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }
.facet {
  background: var(--card); border: 1.5px solid var(--border);
  border-radius: var(--radius-md); transition: all 0.2s;
  overflow: hidden; scroll-margin-top: 20px;
  border-left: 3px solid var(--border);
}
.facet.full { border-left-color: var(--success); }
.facet.partial { border-left-color: var(--amber); }
.facet.none { border-left-color: var(--danger); }
.facet.na { border-left-color: var(--text-dim); }
.facet.open { box-shadow: var(--shadow-sm); }
.facet.pulse { animation: matrixPulse 1.2s ease; }

.facet-header {
  width: 100%; padding: 16px 20px; background: transparent;
  border: none; text-align: left; font: inherit; color: inherit;
  display: flex; align-items: center; gap: 14px;
  transition: background 0.15s;
}
.facet-header:hover { background: var(--bg); }
.facet-num {
  font-family: ui-monospace, monospace; font-size: 11px;
  color: var(--text-dim); font-weight: 600; flex-shrink: 0;
  width: 20px;
}
.facet-icon { font-size: 18px; flex-shrink: 0; }
.facet-meta { flex: 1; min-width: 0; }
.facet-label {
  font-size: 14.5px; font-weight: 600; color: var(--text);
  margin-bottom: 1px;
}
.facet-sub {
  font-size: 12px; color: var(--text-muted);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.facet-state {
  font-size: 11px; font-weight: 600; padding: 3px 10px;
  border-radius: 5px; white-space: nowrap; flex-shrink: 0;
}
.facet-state.full { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.facet-state.partial { background: var(--amber-bg); color: var(--amber); border: 1px solid var(--amber-border); }
.facet-state.none { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
.facet-state.na { background: var(--gray-bg); color: var(--text-muted); border: 1px solid var(--border); }
.facet-chevron {
  color: var(--text-dim); font-size: 12px; flex-shrink: 0;
  transition: transform 0.2s;
}
.facet.open .facet-chevron { transform: rotate(180deg); }

.facet-body { padding: 0 20px 20px 54px; display: none; }
.facet.open .facet-body { display: block; }

.facet-summary {
  font-size: 13px; color: var(--text); line-height: 1.55;
  margin-bottom: 16px; padding: 10px 14px;
  background: var(--bg); border-radius: var(--radius-sm);
}

/* Analyzer participation table */
.analyzers-title {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-dim); font-weight: 600; margin-bottom: 8px;
  display: flex; align-items: center; gap: 8px;
}
.analyzer-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.analyzer {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 12px 14px;
  border-left: 2px solid var(--border);
  transition: all 0.15s;
}
.analyzer.ran { border-left-color: var(--success); }
.analyzer.partial { border-left-color: var(--amber); }
.analyzer.not-run { border-left-color: var(--danger); }
.analyzer.held { border-left-color: var(--text-dim); }
.analyzer-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 12px; margin-bottom: 6px; flex-wrap: wrap;
}
.analyzer-name {
  font-weight: 600; font-size: 13px; color: var(--text);
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.analyzer-version {
  font-family: ui-monospace, monospace; font-size: 10.5px;
  color: var(--text-dim); font-weight: 500;
  padding: 1px 5px; background: var(--gray-bg); border-radius: 3px;
}
.analyzer-status {
  font-size: 10.5px; font-weight: 600; padding: 2px 8px;
  border-radius: 4px; white-space: nowrap;
}
.analyzer-status.ran { background: var(--success-bg); color: var(--success); }
.analyzer-status.partial { background: var(--amber-bg); color: var(--amber); }
.analyzer-status.not-run { background: var(--danger-bg); color: var(--danger); }
.analyzer-status.held { background: var(--gray-bg); color: var(--text-muted); }
.analyzer-facts {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 4px 20px; font-size: 12px;
  padding-top: 8px; border-top: 1px solid var(--border);
}
.analyzer-fact { display: flex; gap: 8px; align-items: baseline; }
.analyzer-fact-label {
  color: var(--text-muted); font-size: 11.5px;
  min-width: 100px; flex-shrink: 0;
}
.analyzer-fact-value {
  color: var(--text); font-weight: 500; word-break: break-word;
}
.analyzer-fact-value.mono { font-family: ui-monospace, monospace; font-size: 11px; }
.analyzer-note {
  margin-top: 8px; font-size: 11.5px; color: var(--amber);
  background: var(--amber-bg); border: 1px solid var(--amber-border);
  padding: 6px 10px; border-radius: 5px; line-height: 1.45;
}
.analyzer.none .analyzer-note {
  background: var(--danger-bg); border-color: var(--danger-border);
  color: var(--danger);
}

/* Established / not established */
.est-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  margin-bottom: 14px;
}
.est-block {
  padding: 12px 14px; border-radius: var(--radius-sm);
}
.est-block.established { background: var(--success-bg); border: 1px solid var(--success-border); }
.est-block.not-established { background: var(--amber-bg); border: 1px solid var(--amber-border); }
.est-block-title {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
  font-weight: 600; margin-bottom: 6px;
}
.est-block.established .est-block-title { color: var(--success); }
.est-block.not-established .est-block-title { color: var(--amber); }
.est-list {
  list-style: none; display: flex; flex-direction: column; gap: 5px;
}
.est-list li {
  font-size: 12px; color: var(--text); line-height: 1.45;
  padding-left: 16px; position: relative;
}
.est-block.established .est-list li::before {
  content: '✓'; position: absolute; left: 0;
  color: var(--success); font-weight: 700; font-size: 11px; top: 1px;
}
.est-block.not-established .est-list li::before {
  content: '○'; position: absolute; left: 2px;
  color: var(--amber); font-size: 10px; top: 1px;
}

.facet-gap-action {
  padding: 10px 14px; background: var(--primary-light);
  border: 1px dashed var(--primary-border);
  border-radius: var(--radius-sm); font-size: 12.5px;
  color: var(--text); line-height: 1.5;
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.facet-gap-action strong { color: var(--primary); font-weight: 600; }
.facet-gap-action .btn-link {
  margin-left: auto; font-size: 12px; color: var(--primary);
  text-decoration: underline; text-underline-offset: 2px;
  background: transparent; border: none; padding: 0;
  font-weight: 500; cursor: pointer;
}

/* Overall "what this does not establish" callout */
.not-establish-callout {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 18px 20px; margin-bottom: 16px;
}
.not-establish-title {
  font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--text-muted); font-weight: 600; margin-bottom: 10px;
}
.not-establish-items {
  display: flex; flex-direction: column; gap: 8px;
}
.not-establish-item {
  display: flex; gap: 10px; align-items: flex-start;
  font-size: 12.5px; line-height: 1.5; color: var(--text-muted);
}
.not-establish-item .icon {
  color: var(--text-dim); font-weight: 700; font-size: 12px;
  flex-shrink: 0; margin-top: 1px;
}

/* Footer */
.drawer-footer {
  padding: 16px 28px; border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  gap: 12px; flex-shrink: 0; background: var(--card);
}
.footer-info { font-size: 12px; color: var(--text-muted); }
.footer-info strong { color: var(--text); font-weight: 500; }
.footer-actions { display: flex; gap: 8px; }

.btn {
  padding: 8px 16px; border-radius: var(--radius-sm); font-size: 13px;
  font-weight: 500; cursor: pointer; border: 1px solid transparent;
  transition: all 0.15s; display: inline-flex; align-items: center;
  gap: 6px; font-family: inherit;
}
.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover { background: var(--primary-hover); }
.btn-ghost { background: transparent; color: var(--text-muted); border-color: var(--border); }
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* Toast */
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: var(--text); color: white; padding: 10px 18px;
  border-radius: 8px; font-size: 13px; font-weight: 500;
  z-index: 100; box-shadow: var(--shadow-md);
  opacity: 0; transition: opacity 0.2s; pointer-events: none;
}

/* Responsive */
@media (max-width: 900px) {
  .drawer { width: 100vw; max-width: none; }
  .drawer-header, .scenario-tabs, .drawer-body, .drawer-footer { padding-left: 16px; padding-right: 16px; }
  .scenario-card-facts { grid-template-columns: repeat(2, 1fr); }
  .matrix { grid-template-columns: repeat(2, 1fr); }
  .analyzer-facts { grid-template-columns: 1fr; }
  .est-grid { grid-template-columns: 1fr; }
  .facet-body { padding-left: 20px; }
}
@media (max-width: 600px) {
  .drawer-title { font-size: 16px; }
  .matrix { grid-template-columns: 1fr; }
  .matrix-item { min-height: 88px; }
  .scenario-card-facts { grid-template-columns: 1fr; gap: 8px; }
  .facet-sub { display: none; }
  .facet-state { font-size: 10px; padding: 2px 7px; }
  .footer-actions { flex-direction: column-reverse; width: 100%; }
  .footer-actions .btn { width: 100%; justify-content: center; }
  .drawer-footer { flex-direction: column; align-items: stretch; }
}
</style>
</head>
<body>

<!-- Host backdrop -->
<div class="host" id="host">
  <div class="host-card">
    <div class="host-crumb">AI Estate · Support Agent v2 · Assurance Case</div>
    <div class="host-title">Detection coverage</div>
    <div class="host-sub">What was analyzed in this evaluation — per source mode, per analyzer.</div>
